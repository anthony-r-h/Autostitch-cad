/.playwright-cli/
# Local artifacts only; canonical sources and published figures belong outside output.
# Retention and cleanup: docs/REPO-CLEANUP.md
/output/

# Optional animation exports; SVGs are the published format.
/examples/illustrated/**/*.gif
/examples/illustrated/**/*.mp4
/examples/counter_examples/assets/*.gif
/examples/counter_examples/assets/*.mp4

# BricsCAD drawing locks
*.dwl
*.dwl2

# Local crash reports and sync conflict copies
*.dmp
* (conflicted).*
* \[conflicted\].*
