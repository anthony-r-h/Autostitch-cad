;;; Native demo entry point. Load AUTOSTITCH.lsp, then this file.
(vl-load-com)
(if (not (member 'ast:load-components (atoms-family 0)))
  (if (findfile "AUTOSTITCH.lsp") (load "AUTOSTITCH.lsp")
    (progn (princ "\nAPPLOAD AUTOSTITCH.lsp before loading examples/demo.lsp.") (exit))))
(if (not ast:*components-loaded*) (ast:load-components))

(defun ast:demo-load-module (name / path)
  (setq path (strcat ast:*home* "/examples/" name))
  (if (findfile path) (load path)
    (princ (strcat "\nDemo module is not available: " name))))

(defun ast:demo-import-polyline (record offset / count flags layer x points item value data)
  (setq count (atoi (cdr (assoc 90 record))) flags (atoi (cdr (assoc 70 record)))
        layer (cdr (assoc 8 record)))
  (ast:cad-require (= layer "STUDY_GUIDES") "The quilt source contains an unexpected layer.")
  (foreach item record
    (setq value (cdr item))
    (cond
      ((= 10 (car item)) (setq x (+ offset (atof value))))
      ((= 20 (car item))
        (ast:cad-require x "The quilt source has an incomplete vertex.")
        (setq points (append points (list (cons 10 (list x (atof value))))) x nil))
      ((= 42 (car item)) (setq points (append points (list (cons 42 (atof value))))))))
  (ast:cad-require (and (null x) (= count (length (vl-remove-if-not '(lambda (p) (= 10 (car p))) points))))
    "The quilt source has an invalid vertex count.")
  (setq data (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 layer)
    '(100 . "AcDbPolyline") (cons 90 count) (cons 70 flags)) points))
  (ast:cad-require (entmakex data) "Could not create a quilt guide."))

(defun ast:demo-import-dxf (path offset / file result line code value active kind record count)
  (setq file (open path "r") count 0)
  (ast:cad-require file (strcat "Cannot read quilt source: " path))
  (setq result (vl-catch-all-apply '(lambda ()
    (while (setq line (read-line file))
      (setq code (atoi line) value (read-line file))
      (ast:cad-require value "The quilt source ends inside a DXF pair.")
      (cond
        ((and (= code 2) (= value "ENTITIES")) (setq active T))
        ((and active (= code 0))
          (if record
            (progn
              (ast:cad-require (= kind "LWPOLYLINE") "The quilt source contains unsupported geometry.")
              (ast:demo-import-polyline (reverse record) offset)
              (setq count (1+ count) record nil)))
          (setq kind value)
          (if (= value "ENDSEC") (setq active nil)))
        (active (setq record (cons (cons code value) record)))))
    (ast:cad-require (> count 0) "The quilt source has no guide polylines.")
    count) nil))
  (close file)
  (if (vl-catch-all-error-p result)
    (ast:cad-require nil (if ast:*cad-error* ast:*cad-error* (vl-catch-all-error-message result))))
  result)

(defun c:ASTQUILTSTUDIES (/ entry count)
  (ast:cad-require (null (ssget "_X" '((410 . "Model")))) "Use a new empty drawing for the quilting studies.")
  (setvar "INSUNITS" 4)
  (ast:show-layer "STUDY_GUIDES" 7 T)
  (setq count 0)
  (foreach entry '(("quilt-a-bolster" "A-BOLSTER" 0.0) ("quilt-b-sweep" "B-SWEEP" 270.0) ("quilt-c-fan" "C-FAN" 540.0))
    (setq count (+ count (ast:demo-import-dxf (strcat ast:*home* "/examples/studies/" (car entry) ".dxf") (caddr entry))))
    (entmakex (list '(0 . "TEXT") '(8 . "0") (cons 10 (list (+ 8.0 (caddr entry)) 250.0 0.0))
      '(40 . 5.0) (cons 1 (cadr entry))))
    (vl-cmdf "_.ZOOM" "_W" (list (caddr entry) 0.0) (list (+ 240.0 (caddr entry)) 260.0))
    (vl-cmdf "_.-VIEW" "_Save" (cadr entry)))
  (vl-cmdf "_.ZOOM" "_E")
  (vl-cmdf "_.-VIEW" "_Save" "ALL")
  (princ (strcat "\nQuilting studies: " (itoa count) " guides. Stitch fitting remains pending."))
  (princ))

(foreach ast:demo-module '("emblem.lsp" "fills.lsp" "velvet.lsp" "demo-export.lsp") (ast:demo-load-module ast:demo-module))
(princ "\nDemos: ASTFILLDEMOS, ASTVELVETDEMO, ASTEMBLEMDEMO, ASTQUILTSTUDIES, ASTDEMOEXPORT.")
(princ)
