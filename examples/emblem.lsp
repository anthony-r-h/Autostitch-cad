;;; Current emblem guide artwork. Load examples/demo.lsp, then ASTEMBLEMDEMO.
(defun ast:show-stroke (points closed) (list closed points))
(defun ast:show-layer (name color plot)
  (if (not (tblsearch "LAYER" name))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
      (cons 2 name) '(70 . 0) (cons 62 color) '(6 . "Continuous") (cons 290 (if plot 1 0))))))
(defun ast:show-polyline (stroke origin / data point)
  (setq data (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "SHOWCASE_GUIDES")
    '(100 . "AcDbPolyline") (cons 90 (length (cadr stroke))) (cons 70 (if (car stroke) 1 0))))
  (foreach point (cadr stroke)
    (setq data (append data (list (cons 10 (mapcar '+ origin (list (car point) (cadr point))))
      (cons 42 (if (caddr point) (caddr point) 0.0))))))
  (entmakex data))
(defun ast:show-outline (letter / outer inner)
  ;; Flat terminals need enough room for both corner constructions and a free gap.
  (cond
    ((= letter "A")
      (setq outer '((0 0) (0 43.8 -1) (27.6 43.8) (27.6 0) (19.5 0) (19.5 21.6) (8.1 21.6) (8.1 0))
            inner '((8.1 29.7) (8.1 43.8 -1) (19.5 43.8) (19.5 29.7))))
    ((= letter "U")
      (setq outer '((0 57.6) (0 13.8 1) (27.6 13.8) (27.6 57.6) (19.5 57.6) (19.5 13.8 -1) (8.1 13.8) (8.1 57.6))))
    ((= letter "T")
      (setq outer '((0 57.6) (32.1 57.6) (32.1 49.5) (20.1 49.5) (20.1 0) (12 0) (12 49.5) (0 49.5))))
    ((= letter "O")
      (setq outer '((0 0) (27.6 0) (27.6 57.6) (0 57.6))
            inner '((8.1 8.1) (19.5 8.1) (19.5 49.5) (8.1 49.5)))))
  (if inner (list (ast:show-stroke outer T) (ast:show-stroke inner T)) (list (ast:show-stroke outer T))))
(defun ast:show-script (letter)
  (cond
    ((= letter "S") (list (ast:show-stroke '((24 36 2.414213562373095) (12 24 -2.414213562373095) (0 12)) nil)))
    ((= letter "t") (list
      (ast:show-stroke '((0 48) (0 12 0.414213562373095) (12 0 0.414213562373095) (24 12)) nil)
      (ast:show-stroke '((-11.7 30) (11.7 30)) nil)))
    ((= letter "i") (list
      (ast:show-stroke '((0 27) (0 12 0.414213562373095) (12 0 0.414213562373095) (24 12)) nil)))
    ((= letter "c") (list (ast:show-stroke '((20.48528137424 20.48528137424 1.496605762665489)
      (12 0 0.198912367379658) (20.48528137424 3.51471862576) (28.97056274848 12)) nil)))
    ((= letter "h") (list
      (ast:show-stroke '((0 0) (0 48)) nil)
      (ast:show-stroke '((0 18) (6 24 -0.668178637919299) (20.48528137424 18) (20.48528137424 6 0.414213562373095)
        (26.48528137424 0 0.414213562373095) (32.48528137424 6)) nil)))))
(defun ast:show-turn (stroke degrees pivot / angle)
  (setq angle (* pi (/ degrees 180.0)))
  (list (car stroke) (mapcar '(lambda (p / x y)
    (setq x (- (car p) (car pivot)) y (- (cadr p) (cadr pivot)))
    (list (+ (car pivot) (- (* x (cos angle)) (* y (sin angle))))
      (+ (cadr pivot) (* x (sin angle)) (* y (cos angle))) (if (caddr p) (caddr p) 0.0))) (cadr stroke))))
(defun ast:show-circle-landmarks (guides circles settings / guide circle points point landmarks result)
  (foreach guide guides
    (setq landmarks nil)
    (foreach circle circles
      (setq points (vlax-invoke (vlax-ename->vla-object guide) 'IntersectWith (vlax-ename->vla-object circle) 0))
      (while points
        (setq point (list (car points) (cadr points) (caddr points)) points (cdddr points)
              landmarks (cons (ast:cad-project guide point) landmarks))))
    (setq result (ast:cad-save-inputs guide settings landmarks))
    (ast:cad-require (ast:cad-get 'ok result) (ast:cad-get 'error result))))
(defun ast:show-square (/ stroke guide guides root roots settings result entry members circles radius dot fill)
  (setq settings (ast:cad-default-settings))
  ;; Circles are pattern references; their intersections constrain the lettering.
  (foreach entry '(("A" 391.5 4.0 14.0 13.8) ("U" 427.1 14.0 5.0 13.8)
                  ("T" 462.7 14.0 -5.0 16.05) ("O" 502.8 4.0 -14.0 13.8))
    (foreach stroke (ast:show-outline (car entry))
      (setq guide (ast:show-polyline (ast:show-turn stroke (nth 3 entry) (list (nth 4 entry) 0.0))
        (list (cadr entry) (caddr entry))) roots (cons guide roots) guides (cons guide guides))))
  (foreach entry '(("S" 362.0) ("t" 399.0) ("i" 428.0) ("t" 457.0) ("c" 486.0) ("h" 518.0))
    (setq members (mapcar '(lambda (stroke) (ast:show-polyline (ast:show-turn stroke -12.0 '(0 0))
      (list (cadr entry) -53.0))) (ast:show-script (car entry))) root (car members))
    (foreach guide (cdr members)
      (setq result (ast:cad-connect-guides root guide nil settings nil))
      (ast:cad-require (ast:cad-get 'ok result) (ast:cad-get 'error result)))
    (setq roots (cons root roots) guides (append members guides)))
  ;; One round punch is the tittle, not a small loop of stitch holes.
  (ast:show-layer "SHOWCASE_PATTERN" 7 T)
  (setq dot (list (+ 428.0 (* 39.0 (sin (* pi (/ 12.0 180.0)))))
    (+ -53.0 (* 39.0 (cos (* pi (/ 12.0 180.0)))))))
  (entmakex (list '(0 . "CIRCLE") '(8 . "SHOWCASE_PATTERN") (cons 10 (append dot '(0.0))) '(40 . 1.5)))
  (ast:cad-write-hole-fill (list (cons 'center dot) '(diameter . 3.0)) 1.0)
  (setq fill (entlast))
  (entmod (subst '(8 . "SHOWCASE_PATTERN") (assoc 8 (entget fill)) (entget fill)))
  (ast:show-layer "SHOWCASE_CIRCLES" 7 T)
  (foreach radius '(110.0 95.0 80.0)
    (setq circles (cons (entmakex (list '(0 . "CIRCLE") '(8 . "SHOWCASE_CIRCLES")
      '(370 . 13) '(10 461.0 7.07097512664247 0.0)
      (cons 40 radius))) circles)))
  (ast:show-circle-landmarks guides circles settings)
  roots)
(defun c:ASTEMBLEMDEMO (/ roots)
  (ast:cad-require (null (ssget "_X" '((410 . "Model")))) "Use a new empty drawing for the emblem.")
  (setvar "INSUNITS" 4)
  (ast:show-layer "SHOWCASE_GUIDES" 8 nil)
  (setq roots (ast:show-square))
  (vl-cmdf "_.-LAYER" "_OFF" "AUTOSTITCH_UI" "")
  (vl-cmdf "_.ZOOM" "_W" '(333.0 -120.9290248733575) '(589.0 135.0709751266425))
  (vl-cmdf "_.-VIEW" "_Save" "EMBLEM")
  (princ "\nEmblem guides created. Stitch fitting remains pending.")
  (princ))
(princ)
