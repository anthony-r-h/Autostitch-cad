(defun ast:fill-paths (kind parameters / paths value low high radius center step cells extension values chord sag allowed parameter)
  (setq allowed (assoc kind '(("MAZE") ("CIRCLES" count center spacing inner-radius)
    ("QUILT" crossing-spacing cells extension) ("FLOW" start chord sag rows row-spacing))))
  (ast:cad-require allowed "Unknown fill recipe.")
  (setq allowed (cdr allowed))
  (foreach parameter parameters
    (ast:cad-require (member (car parameter) allowed) (strcat "Unknown fill parameter: " (vl-prin1-to-string (car parameter)))))
  (cond
    ((= kind "MAZE")
      (setq paths (ast:fill-maze-paths)))
    ((= kind "CIRCLES")
      (setq radius (ast:g-get 'inner-radius parameters 9.0)
        center (ast:g-get 'center parameters '(24.0 24.0))
        step (ast:g-get 'spacing parameters 6.0))
      (repeat (ast:g-get 'count parameters 5)
        (setq paths (append paths (list (list
          (list (+ (car center) radius) (cadr center) 1.0)
          (list (- (car center) radius) (cadr center) 1.0)
          (list (+ (car center) radius) (cadr center)))))
          radius (+ radius step))))
    ((= kind "QUILT")
      (setq step (ast:g-get 'crossing-spacing parameters 6.0) cells (ast:g-get 'cells parameters 7)
        extension (ast:g-get 'extension parameters 6.0) low (* -0.5 cells step) high (- low) value low)
      (repeat (1+ cells) (setq values (append values (list value)) value (+ value step)))
      (setq paths (list (mapcar 'ast:fill-rotate (list (list (- low extension) low) (list (+ high extension) low)))))
      (foreach value values
        (setq paths (append paths (list (mapcar 'ast:fill-rotate (list (list value (- low extension)) (list value (+ high extension))))))))
      (foreach value (cdr values)
        (setq paths (append paths (list (mapcar 'ast:fill-rotate (list (list (- low extension) value) (list (+ high extension) value))))))))
    ((= kind "FLOW")
      (setq center (ast:g-get 'start parameters '(6.0 6.0)) value (cadr center)
        chord (ast:g-get 'chord parameters 36.0) sag (ast:g-get 'sag parameters 3.0))
      (repeat (ast:g-get 'rows parameters 25)
        (setq paths (cons (ast:fill-flow-row (list (car center) value) chord sag 3.0) paths)
          value (+ value (ast:g-get 'row-spacing parameters 3.0)))))
    (T (ast:cad-require nil "Unknown fill recipe.")))
  paths)
(defun ast:fill-guides (kind origin / guides path)
  (foreach path (ast:fill-paths kind nil)
    (setq guides (append guides (list (ast:fill-poly path origin)))))
  guides)
(defun ast:fill-plans (guides connected / states connections groups group members group-states group-connections solved plans node)
  (setq states (ast:cad-set-states guides nil (ast:cad-default-settings) nil))
  (ast:cad-set-check states nil)
  (if connected
    (setq connections (ast:cad-get 'connections (ast:cad-all-connections states nil))))
  (setq groups (ast:cad-components (length states) connections))
  (foreach group groups
    (setq members (mapcar '(lambda (index) (nth index guides)) group)
      group-states (mapcar '(lambda (index) (nth index states)) group)
      group-connections nil)
    (foreach node connections
      (if (member (ast:cad-get 'path (car (ast:cad-get 'incidences node))) group)
        (setq group-connections (append group-connections (list node)))))
    (setq group-connections (ast:cad-remap-connections group-connections guides members)
      solved (ast:cad-resolve-set group-states group-connections)
      plans (append plans (list (append (list (cons 'states group-states)) solved)))))
  plans)
(defun ast:fill-bounds (guides / guide low high minimum maximum width center)
  (foreach guide guides
    (vla-GetBoundingBox (vlax-ename->vla-object guide) 'low 'high)
    (setq low (vlax-safearray->list low) high (vlax-safearray->list high)
      minimum (if minimum (mapcar 'min minimum low) low)
      maximum (if maximum (mapcar 'max maximum high) high)))
  (setq width (+ 6.0 (max (- (car maximum) (car minimum)) (- (cadr maximum) (cadr minimum))))
    center (ast:g-mul (ast:g-add minimum maximum) 0.5))
  (list (cons 'origin (ast:g-sub center (list (/ width 2.0) (/ width 2.0)))) (cons 'width width)
    (cons 'guide-width (- (car maximum) (car minimum))) (cons 'guide-height (- (cadr maximum) (cadr minimum)))))
(defun ast:fill-case (kind origin / settings guides plans plan openings result error width bounds)
  (setq settings (ast:cad-default-settings) guides (ast:fill-guides kind origin)
        bounds (ast:fill-bounds guides) width (ast:cad-get 'width bounds)
        plans (ast:fill-plans guides (member kind '("QUILT" "MAZE"))))
  ;; Fit every component and check clearance before writing any stitch output.
  (foreach plan plans
    (setq openings (append openings (ast:cad-get 'openings (ast:cad-get 'solution plan)))))
  (setq error (ast:g-validate-openings openings settings))
  (ast:cad-require (null error) error)
  (setq result (ast:cad-transaction 'ast:cad-write-components-inner (list plans)))
  (ast:cad-require (ast:cad-get 'ok result) (ast:cad-get 'error result))
  (vl-cmdf "_.ZOOM" "_W" (ast:cad-get 'origin bounds) (ast:g-add (ast:cad-get 'origin bounds) (list width width)))
  (vl-cmdf "_.-VIEW" "_Save" kind)
  (append (list '(ok . T) (cons 'name kind) '(pitch . 3.0)
    (cons 'settings settings) (cons 'guides (length guides)) (cons 'sources (length plans)) (cons 'openings (length openings))) bounds))
(defun c:ASTFILLDEMOS (/ entry kind result results failure)
  (ast:cad-require (null (ssget "_X" '((410 . "Model")))) "Build fills in a new empty drawing.")
  (setvar "INSUNITS" 4) (ast:fill-layer)
  (setq ast:fill-results nil)
  (foreach entry '(("QUILT" 0.0) ("CIRCLES" 320.0) ("MAZE" 480.0) ("FLOW" 640.0))
    (setq kind (car entry) ast:*cad-error* nil
      result (vl-catch-all-apply 'ast:fill-case (list kind (list (cadr entry) 0.0))))
    (if (vl-catch-all-error-p result)
      (setq result (list '(ok . nil) (cons 'name kind) (cons 'error (if ast:*cad-error* ast:*cad-error* (vl-catch-all-error-message result)))) failure T))
    (setq ast:fill-results (append ast:fill-results (list result)))
    (princ (strcat "\n" (vl-prin1-to-string result))))
  (vl-cmdf "_.-LAYER" "_OFF" "AUTOSTITCH_UI,FILL_GUIDES" "")
  (setvar "LWDISPLAY" 1) (setvar "UCSICON" 0)
  (vl-cmdf "_.ZOOM" "_E")
  (list (cons 'ok (null failure)) (cons 'cases ast:fill-results)))
(defun c:ASTQUILTDEMO ()
  (ast:cad-require (null (ssget "_X" '((410 . "Model")))) "Build quilting in a new empty drawing.")
  (setvar "INSUNITS" 4) (ast:fill-layer)
  (ast:fill-case "QUILT" '(0.0 0.0)))
(princ "\nNative fills: ASTFILLDEMOS, ASTQUILTDEMO (empty drawings).")
(princ)
