;;; Native fill specimens. Load AUTOSTITCH.lsp and its components first.
;;; All dimensions are mm; generated openings use the production solver.
(defun ast:fill-layer ()
  (if (not (tblsearch "LAYER" "FILL_GUIDES"))
    (entmake '((0 . "LAYER") (100 . "AcDbSymbolTableRecord") (100 . "AcDbLayerTableRecord")
      (2 . "FILL_GUIDES") (70 . 0) (62 . 8) (6 . "Continuous") (290 . 0)))))
(defun ast:fill-poly (vertices origin / data point closed)
  (setq closed (equal (list (caar vertices) (cadar vertices)) (list (car (last vertices)) (cadr (last vertices))) 1e-9))
  (if closed (setq vertices (reverse (cdr (reverse vertices)))))
  (setq data (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "FILL_GUIDES")
    '(100 . "AcDbPolyline") (cons 90 (length vertices)) (cons 70 (if closed 1 0))))
  (foreach point vertices
    (setq data (append data (list (cons 10 (ast:g-add origin (list (car point) (cadr point))))
      (cons 42 (if (caddr point) (caddr point) 0.0))))))
  (entmakex data))
(defun ast:fill-rotate (point / scale)
  (setq scale (/ 1.0 (sqrt 2.0)))
  (list (+ 48.0 (* scale (- (car point) (cadr point))))
        (+ 48.0 (* scale (+ (car point) (cadr point))))))
(defun ast:fill-flow-row (start chord sag pitch / radius sweep step count half center first last bulge)
  (ast:cad-require (and (> chord 0.0) (> sag 0.0)) "Flow needs a positive chord and sag.")
  (setq radius (/ (+ (* chord chord) (* 4.0 sag sag)) (* 8.0 sag))
        sweep (* 4.0 (atan (/ (* 2.0 sag) chord))))
  (ast:cad-require (<= pitch (* 2.0 radius)) "This flow curve is too tight for the pitch.")
  (setq step (* 2.0 (ast:g-asin (/ pitch (* 2.0 radius))))
        count (ast:g-floor-near (/ sweep step)))
  (ast:cad-require (> count 0) "This flow row has less than one stitch of room.")
  ;; Free ends stop at a whole count of nominal chord gaps; the curve stays fixed.
  (setq half (* 0.5 count step) center (ast:g-add start (list (* 0.5 chord) (- sag radius)))
        first (ast:g-add center (list (- (* radius (sin half))) (* radius (cos half))))
        last (ast:g-add center (list (* radius (sin half)) (* radius (cos half))))
        bulge (- (/ (sin (* 0.5 half)) (cos (* 0.5 half)))))
  (list (append first (list bulge)) last))
