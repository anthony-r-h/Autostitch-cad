;;; Exact matching of solved stitching. Load after geometry and network.
;;; A matching copy transforms the solution; it never invokes a pitch solver.
(defun ast:m-vector (vector transform / old-axis new-axis)
  (setq old-axis (ast:g-get 'old-axis transform nil) new-axis (ast:g-get 'new-axis transform nil))
  (ast:g-add (ast:g-mul new-axis (ast:g-dot vector old-axis))
    (ast:g-mul (ast:g-left new-axis) (* (ast:g-get 'parity transform 1) (ast:g-dot vector (ast:g-left old-axis))))))
(defun ast:m-point (point transform)
  (ast:g-add (ast:g-get 'target transform nil)
    (ast:m-vector (ast:g-sub point (ast:g-get 'origin transform nil)) transform)))
(defun ast:m-primitive (primitive transform / radial)
  (if (= (ast:g-get 'kind primitive nil) 'line)
    (ast:n-put 'a (ast:m-point (ast:g-get 'a primitive nil) transform)
      (ast:n-put 'b (ast:m-point (ast:g-get 'b primitive nil) transform) primitive))
    (progn
      (setq radial (ast:m-vector (list (cos (ast:g-get 'start-angle primitive 0.0)) (sin (ast:g-get 'start-angle primitive 0.0))) transform))
      (ast:n-put 'center (ast:m-point (ast:g-get 'center primitive nil) transform)
        (ast:n-put 'start-angle (atan (cadr radial) (car radial))
          (ast:n-put 'sweep (* (ast:g-get 'parity transform 1) (ast:g-get 'sweep primitive 0.0)) primitive))))))
(defun ast:m-route (route transform)
  (ast:n-put 'primitives (mapcar '(lambda (primitive) (ast:m-primitive primitive transform)) (ast:g-get 'primitives route nil)) route))
(defun ast:m-length (route)
  (apply '+ (mapcar 'ast:g-length (ast:g-get 'primitives route nil))))
(defun ast:m-frame (route phase reversed / primitives total primitive)
  (setq primitives (ast:g-get 'primitives route nil) total (ast:m-length route))
  (if (null phase) (setq phase (if (and reversed (not (ast:g-get 'closed route nil))) total 0.0)))
  (if (and (ast:g-finite phase) (>= phase 0.0) (<= phase total))
    (progn
      (if reversed (setq primitives (mapcar 'ast:g-reverse-primitive (reverse primitives)) phase (- total phase)))
      (if (and (ast:g-get 'closed route nil) (equal phase total 1e-8)) (setq phase 0.0))
      (while (and (cdr primitives) (>= phase (- (ast:g-length (car primitives)) 1e-8)))
        (setq phase (max 0.0 (- phase (ast:g-length (car primitives)))) primitives (cdr primitives)))
      (setq primitive (car primitives))
      (list (cons 'point (ast:g-point primitive phase)) (cons 'axis (ast:g-tangent primitive phase))))))
(defun ast:m-cycle (primitives station / before primitive size after)
  ;; Rotate a closed route at an exact arc-length station, splitting only there.
  (while (and primitives (>= station (- (ast:g-length (car primitives)) 1e-8)))
    (setq station (max 0.0 (- station (ast:g-length (car primitives))))
          before (append before (list (car primitives))) primitives (cdr primitives)))
  (cond
    ((null primitives) before)
    ((< station 1e-8) (append primitives before))
    (T
      (setq primitive (car primitives) size (ast:g-length primitive)
            after (cons (ast:g-trim-primitive primitive station size) (cdr primitives)))
      (append after before (list (ast:g-trim-primitive primitive 0.0 station))))))
(defun ast:m-same-span (aa start-a bb start-b distance)
  ;; Equal support and directed length prove equality; endpoints are not samples.
  (and (= (ast:g-get 'kind aa nil) (ast:g-get 'kind bb nil))
    (< (ast:g-dist (ast:g-point aa start-a) (ast:g-point bb start-b)) 1e-7)
    (< (ast:g-dist (ast:g-point aa (+ start-a distance)) (ast:g-point bb (+ start-b distance))) 1e-7)
    (or (= (ast:g-get 'kind aa nil) 'line)
      (and (< (ast:g-dist (ast:g-get 'center aa nil) (ast:g-get 'center bb nil)) 1e-7)
        (< (abs (- (ast:g-get 'radius aa 0.0) (ast:g-get 'radius bb 0.0))) 1e-7)
        (= (ast:g-sign (ast:g-get 'sweep aa 0.0)) (ast:g-sign (ast:g-get 'sweep bb 0.0)))))))
(defun ast:m-same-primitives (aa bb / start-a start-b left-a left-b span valid)
  ;; Walk the union of segment boundaries, so redundant subdivisions do not matter.
  (setq start-a 0.0 start-b 0.0 valid T)
  (while (and valid aa bb)
    (setq left-a (- (ast:g-length (car aa)) start-a) left-b (- (ast:g-length (car bb)) start-b)
          span (min left-a left-b) valid (ast:m-same-span (car aa) start-a (car bb) start-b span)
          start-a (+ start-a span) start-b (+ start-b span))
    (if (< (- left-a span) 1e-8) (setq aa (cdr aa) start-a 0.0))
    (if (< (- left-b span) 1e-8) (setq bb (cdr bb) start-b 0.0)))
  (and valid (null aa) (null bb)))
(defun ast:m-stations (route point / offset primitive station positions total)
  (setq offset 0.0 total (ast:m-length route))
  (foreach primitive (ast:g-get 'primitives route nil)
    (setq station (ast:n-station primitive point))
    (if (and (>= station -1e-8) (<= station (+ (ast:g-length primitive) 1e-8))
             (< (ast:g-dist point (ast:g-point primitive station)) 1e-7))
      (progn
        (setq station (+ offset station))
        (if (and (ast:g-get 'closed route nil) (equal station total 1e-8)) (setq station 0.0))
        (if (not (vl-some '(lambda (item) (equal item station 1e-8)) positions)) (setq positions (append positions (list station))))))
    (setq offset (+ offset (ast:g-length primitive)))) positions)
(defun ast:m-match-route (source target required-reverse / source-primitives target-primitives point phases phase reversed oriented matches total)
  (setq source-primitives (ast:g-get 'primitives source nil) target-primitives (ast:g-get 'primitives target nil)
        point (ast:g-point (car source-primitives) 0.0) total (ast:m-length target))
  (if (and (eq (not (null (ast:g-get 'closed source nil))) (not (null (ast:g-get 'closed target nil))))
           (< (abs (- (ast:m-length source) total)) 1e-7))
    (foreach reversed (if (= required-reverse 'any) '(nil T) (list required-reverse))
      (setq phases (if (ast:g-get 'closed target nil) (ast:m-stations target point) (list (if reversed total 0.0))))
      (foreach phase phases
        (setq oriented (if reversed (mapcar 'ast:g-reverse-primitive (reverse target-primitives)) target-primitives))
        (if (ast:g-get 'closed target nil) (setq oriented (ast:m-cycle oriented (if reversed (- total phase) phase))))
        (if (ast:m-same-primitives source-primitives oriented)
          (setq matches (cons (list '(ok . T) (cons 'reversed reversed) (cons 'phase phase)) matches))))))
  (if (= (length matches) 1) (car matches)))
(defun ast:m-map-routes (source-routes target-routes parity target-reversed source-phase target-phase / error route source-frame target-frame transform source-index target-index transformed candidates candidate pairs used match)
  (cond
    ((or (null source-routes) (/= (length source-routes) (length target-routes)))
      (setq error "Select the same number of guides as the source stitch line."))
    ((not (member parity '(1 -1))) (setq error "Choose Front or Back for the matching copy.")))
  (foreach route (append source-routes target-routes)
    (if (null error) (setq error (ast:n-route-error route))))
  (if (null error)
    (progn
      (setq source-frame (ast:m-frame (car source-routes) source-phase nil)
            target-frame (ast:m-frame (car target-routes) target-phase target-reversed))
      (if (or (null source-frame) (null target-frame))
        (setq error "The matching start is outside its guide. Pick a point on the guide.")
        (setq transform (list (cons 'origin (ast:g-get 'point source-frame nil)) (cons 'target (ast:g-get 'point target-frame nil))
          (cons 'old-axis (ast:g-get 'axis source-frame nil)) (cons 'new-axis (ast:g-get 'axis target-frame nil)) (cons 'parity parity))))))
  (setq source-index 0)
  (foreach route source-routes
    (if (null error)
      (progn
        (setq transformed (ast:m-route route transform) candidates nil target-index 0)
        (foreach candidate target-routes
          (if (and (not (member target-index used)) (or (/= source-index 0) (= target-index 0))
                   (setq match (ast:m-match-route transformed candidate (if (= source-index 0) target-reversed 'any))))
            (setq candidates (cons (ast:n-put 'source-index source-index (ast:n-put 'target-index target-index match)) candidates)))
          (setq target-index (1+ target-index)))
        (cond
          ((null candidates) (setq error "These guides do not match the source shape and size. Check the matching end and Front or Back."))
          ((/= (length candidates) 1) (setq error "More than one target guide matches the same source guide. Remove the duplicate selection."))
          (T (setq match (car candidates) pairs (append pairs (list match)) used (cons (ast:g-get 'target-index match nil) used))))))
    (setq source-index (1+ source-index)))
  (if error (ast:g-error error) (list '(ok . T) (cons 'transform transform) (cons 'pairs pairs))))

(defun ast:m-fields (record fields transform / field)
  (foreach field fields
    (if (assoc field record) (setq record (ast:n-put field (ast:m-point (ast:g-get field record nil) transform) record)))) record)
(defun ast:m-opening (opening transform)
  (setq opening (ast:m-fields opening '(center) transform))
  (if (assoc 'axis opening) (setq opening (ast:n-put 'axis (ast:m-vector (ast:g-get 'axis opening nil) transform) opening))) opening)
(defun ast:m-connection (connection transform / incidences incidence route)
  (foreach incidence (ast:g-get 'incidences connection nil)
    (if (setq route (ast:g-get 'source-route incidence nil)) (setq incidence (ast:n-put 'source-route (ast:m-route route transform) incidence)))
    (setq incidences (append incidences (list incidence))))
  (ast:n-put 'incidences incidences (ast:m-fields connection '(point) transform)))
(defun ast:m-solution (solution transform / field)
  (foreach field '(openings virtual-slits)
    (if (assoc field solution)
      (setq solution (ast:n-put field (mapcar '(lambda (item) (ast:m-opening item transform)) (ast:g-get field solution nil)) solution))))
  (if (assoc 'primitives solution)
    (setq solution (ast:n-put 'primitives (mapcar '(lambda (item) (ast:m-primitive item transform)) (ast:g-get 'primitives solution nil)) solution)))
  (if (assoc 'intervals solution)
    (setq solution (ast:n-put 'intervals (mapcar '(lambda (item) (ast:m-fields item '(from to) transform)) (ast:g-get 'intervals solution nil)) solution)))
  (if (assoc 'corner-adjustments solution)
    (setq solution (ast:n-put 'corner-adjustments (mapcar '(lambda (item) (ast:m-fields item '(center virtual-center) transform)) (ast:g-get 'corner-adjustments solution nil)) solution)))
  (if (assoc 'connections solution)
    (setq solution (ast:n-put 'connections (mapcar '(lambda (item) (ast:m-connection item transform)) (ast:g-get 'connections solution nil)) solution))) solution)
(princ)
