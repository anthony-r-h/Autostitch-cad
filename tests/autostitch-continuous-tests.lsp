;;; Continuous spans: actual production geometry, with independent distance checks.
(defun ast:c-check (condition label)
  (setq ast:c-count (1+ ast:c-count))
  (if (not condition) (setq ast:c-failures (cons label ast:c-failures))))
(defun ast:c-line (a b) (list '(kind . line) (cons 'a a) (cons 'b b)))
(defun ast:c-route ()
  (list (cons 'primitives (list (ast:c-line '(0.0 0.0) '(2.0 0.0))
    (ast:c-line '(2.0 0.0) '(4.0 0.1)) (ast:c-line '(4.0 0.1) '(12.0 1.0))))))
(defun ast:c-curved-route (/ index angle-value previous point parts)
  (setq index 1 previous '(0.0 0.0))
  (repeat 80
    (setq angle-value (* 0.6 (/ index 80.0)) point (list (* 200.0 (- 1.0 (cos angle-value))) (* 200.0 (sin angle-value)))
          parts (append parts (list (ast:c-line previous point))) previous point index (1+ index)))
  (list (cons 'primitives parts)))
(defun ast:c-valid (result pitch / valid interval primitive a b measured)
  (setq valid (ast:g-get 'ok result nil))
  (foreach interval (ast:g-get 'intervals result nil)
    (if (/= (ast:g-get 'kind interval nil) 'junction)
      (progn
        (setq primitive (nth (ast:g-get 'primitive interval nil) (ast:g-get 'primitives result nil))
              a (ast:g-point primitive (ast:g-get 'start-station interval nil))
              b (ast:g-point primitive (ast:g-get 'end-station interval nil)) measured (distance a b))
        (if (or (< measured (- (* 0.9 pitch) 1e-7)) (> measured (+ (* 1.1 pitch) 1e-7))
                (and (= (ast:g-get 'kind interval nil) 'ordinary) (> (abs (- measured pitch)) 1e-7))) (setq valid nil))))) valid)
(defun ast:c-tests (/ ast:c-count ast:c-failures route settings result reversed primitive arc range source target connections full transformed mapping split before after corner point value angle-value points parts expected chosen)
  (setq ast:c-count 0 settings '((pitch . 3.0)) route (ast:c-route)
        result (ast:g-solve route settings nil))
  (ast:c-check (and (ast:c-valid result 3.0)
    (= 5 (length (ast:g-get 'openings result nil)))) "Default fitting crosses short facets without a separate mode")
  (ast:c-check (and (= 0 (length (vl-remove-if-not '(lambda (hole) (= (ast:g-get 'type hole nil) 'round)) (ast:g-get 'openings result nil))))
    (not (vl-some '(lambda (hole) (or (equal '(2.0 0.0) (ast:g-get 'center hole nil) 1e-8)
      (equal '(4.0 0.1) (ast:g-get 'center hole nil) 1e-8))) (ast:g-get 'openings result nil))))
    "Continuous vertices introduce neither round holes nor fixed slits")
  (setq reversed (ast:g-solve route (ast:n-put 'reverse T settings) nil))
  (ast:c-check (and (ast:c-valid reversed 3.0)
    (equal '(12.0 1.0) (ast:g-get 'center (car (ast:g-get 'openings reversed nil)) nil) 1e-8))
    "Reversed continuous fitting preserves endpoints and actual chord bounds")
  (setq split (ast:n-put 'primitives (append (list (ast:c-line '(0.0 0.0) '(1.0 0.0)) (ast:c-line '(1.0 0.0) '(2.0 0.0)))
    (cdr (ast:g-get 'primitives route nil))) route))
  (ast:c-check (equal (ast:g-get 'openings result nil) (ast:g-get 'openings (ast:g-solve split settings nil) nil) 1e-7)
    "Redundant subdivision leaves continuous openings unchanged")
  (setq range (list (cons 'start '((primitive . 0) (station . 0.3))) (cons 'end '((primitive . 2) (station . 3.0))) (cons 'source-route route)))
  (ast:c-check (equal (ast:g-get 'openings result nil) (ast:g-get 'openings (ast:g-solve route (ast:n-put 'continuous (list range) settings) nil) nil) 1e-7)
    "Retired continuous selections do not change automatic fitting")
  (setq result (ast:g-solve (list (cons 'primitives (list (ast:c-line '(0.0 0.0) '(4.5 0.0))
    (ast:c-line '(4.5 0.0) '(6.5 0.1)) (ast:c-line '(6.5 0.1) '(18.0 1.0))))) settings '(((primitive . 1) (station . 0.0)))))
  (ast:c-check (and (ast:c-valid result 3.0) (vl-some '(lambda (gap) (and (ast:g-get 'reserved gap nil)
    (< (abs (- 3.0 (ast:g-get 'distance gap 0.0))) 1e-7))) (ast:g-get 'intervals result nil)))
    "A landmark reserves a nominal chord across continuous vertices")
  (setq arc '((kind . arc) (center 10.0 20.0) (radius . 20.0) (start-angle . -1.5707963267948966) (sweep . 0.8))
        route (list (cons 'primitives (list (ast:c-line '(0.0 0.0) '(10.0 0.0)) arc)))
        result (ast:g-solve route settings nil))
  (ast:c-check (and (ast:c-valid result 3.0) (not (vl-some '(lambda (hole) (equal '(10.0 0.0) (ast:g-get 'center hole nil) 1e-8)) (ast:g-get 'openings result nil))))
    "Tangent line and arc continue without a mandatory join slit")
  (setq route (list '(closed . T) (cons 'primitives (list (ast:c-line '(0.0 0.0) '(15.0 0.0))
    (ast:c-line '(15.0 0.0) '(15.0 15.0)) (ast:c-line '(15.0 15.0) '(0.0 15.0)) (ast:c-line '(0.0 15.0) '(0.0 0.0)))))
        result (ast:g-solve route (ast:n-put 'slit-length 0.5 settings) nil))
  (ast:c-check (and (ast:c-valid result 3.0) (= 4 (length (vl-remove-if-not '(lambda (hole) (= (ast:g-get 'type hole nil) 'round)) (ast:g-get 'openings result nil)))))
    "Default fitting retains all four protected square corners")
  (setq route (ast:n-put 'primitives (append (reverse (cdr (reverse (ast:g-get 'primitives (ast:c-route) nil))))
    (list (ast:c-line '(4.0 0.1) '(15.0 1.0)))) (ast:c-route)) source (list '(id . 0) (cons 'route route) (cons 'settings settings))
        target (list '(id . 1) (cons 'route (list (cons 'primitives (list (ast:c-line '(-12.0 0.0) '(12.0 0.0)))))) '(settings (pitch . 3.0)))
        connections (ast:g-get 'connections (ast:g-connect-candidates route (ast:g-get 'route target nil)) nil))
  ;; Use a vertical branch to avoid overlap with the first facet.
  (setq target (ast:n-put 'route (list (cons 'primitives (list (ast:c-line '(0.0 -13.5) '(0.0 13.5))))) target)
        connections (ast:g-get 'connections (ast:g-connect-candidates route (ast:g-get 'route target nil)) nil)
        result (ast:g-solve-set (list source target) connections))
  (ast:c-check (and (ast:c-valid result 3.0) (= 1 (length (vl-remove-if-not '(lambda (hole) (= (ast:g-get 'type hole nil) 'round)) (ast:g-get 'openings result nil))))
    (vl-some '(lambda (gap) (and (= (ast:g-get 'kind gap nil) 'junction) (< (abs (- 1.5 (ast:g-get 'distance gap 0.0))) 1e-7))) (ast:g-get 'intervals result nil)))
    "Continuous connected guides preserve shared branch holes and half-pitch neighbours")
  (setq route (list (cons 'primitives (append (ast:g-get 'primitives (ast:c-route) nil) (list (ast:c-line '(12.0 1.0) '(12.0 20.0))))))
        range (list (cons 'start '((primitive . 0) (station . 0.3))) (cons 'end '((primitive . 2) (station . 3.0))) (cons 'source-route route))
        result (ast:g-solve route (ast:n-put 'continuous (list range) settings) nil))
  (ast:c-check (and (ast:c-valid result 3.0) (= 1 (length (vl-remove-if-not '(lambda (hole) (= (ast:g-get 'type hole nil) 'round)) (ast:g-get 'openings result nil)))))
    "Default fitting retains the corner following a faceted curve")
  (setq route (list (cons 'primitives (list (ast:c-line '(0.0 0.0) '(0.5 0.0))
    (ast:c-line '(0.5 0.0) '(2.0 0.02)) (ast:c-line '(2.0 0.02) '(15.0 1.0)))))
        source (ast:n-put 'route route source)
        connections (ast:g-get 'connections (ast:g-connect-candidates route (ast:g-get 'route target nil)) nil)
        result (ast:g-solve-set (list source target) connections))
  (ast:c-check (and (ast:c-valid result 3.0)
    (vl-some '(lambda (hole) (and (= (ast:g-get 'type hole nil) 'slit)
      (> (car (ast:g-get 'center hole nil)) 0.5) (< (abs (- (distance '(0.0 0.0) (ast:g-get 'center hole nil)) 1.5)) 1e-7)))
      (ast:g-get 'openings result nil)))
    "Branch reservations can cross short continuous facets while retaining the half-pitch chord")
  (setq route (ast:c-route) source (list '(id . 0) (cons 'route route) (cons 'settings settings))
        target (list '(id . 1) (cons 'route (list (cons 'primitives (list (ast:c-line '(0.0 0.0) '(-12.0 0.0)))))) '(settings (pitch . 3.0)))
        connections (ast:g-get 'connections (ast:g-connect-candidates route (ast:g-get 'route target nil)) nil)
        result (ast:g-solve-set (list source target) connections))
  (ast:c-check (and (ast:c-valid result 3.0) (= 1 (length (ast:g-get 'primitives result nil)))
    (not (vl-some '(lambda (hole) (equal '(0.0 0.0) (ast:g-get 'center hole nil) 1e-8)) (ast:g-get 'openings result nil))))
    "A reversed straight continuation into another guide remains one uninterrupted span")
  (setq result (ast:g-solve (ast:c-curved-route) settings nil))
  (ast:c-check (and (ast:c-valid result 3.0) (> (length (ast:g-get 'openings result nil)) 35)
    (= 1 (length (ast:g-get 'primitives result nil))))
    "An eighty-facet curved side fits as one continuous span at three millimetre pitch")
  ;; Reduced from ST-68: a faceted curve feeds each long arm of a U-shaped guide.
  (setq points '((0.6 30.0) (0.02 24.0) (0.0 23.8) (0.0 0.0) (30.0 0.0) (30.0 23.8) (29.98 24.0) (29.4 30.0))
        parts nil)
  (while (cdr points)
    (setq parts (append parts (list (ast:c-line (car points) (cadr points)))) points (cdr points)))
  (setq route (list (cons 'primitives parts)) result (ast:g-solve route settings nil))
  (ast:c-check (and (ast:c-valid result 3.0) (= 2 (length (vl-remove-if-not '(lambda (hole) (= (ast:g-get 'type hole nil) 'round)) (ast:g-get 'openings result nil)))))
    "Default fitting keeps both standard corners where faceted curves feed a U-shaped guide")
  (setq chosen T)
  (foreach value '(2 3)
    (setq corner (ast:g-corner (nth value parts) (nth (1+ value) parts) settings))
    (foreach expected (list (ast:g-get 'opening corner nil)
      (ast:g-slit (nth value parts) (ast:g-get 'incoming-station corner 0.0) settings)
      (ast:g-slit (nth (1+ value) parts) (ast:g-get 'outgoing-station corner 0.0) settings))
      (if (not (vl-some '(lambda (hole) (ast:g-same-opening expected hole)) (ast:g-get 'openings result nil))) (setq chosen nil))))
  (ast:c-check (and chosen (vl-some '(lambda (gap) (= (ast:g-get 'kind gap nil) 'corrected)) (ast:g-get 'intervals result nil)))
    "Continuous fitting fixes the existing corner holes and neighbours and redistributes only free-span gaps")
  (setq range (list '(start (primitive . 0) (station . 0.0))
    (cons 'end (list '(primitive . 6) (cons 'station (ast:g-length (nth 6 parts)))))))
  (ast:c-check (equal (ast:g-get 'openings result nil)
    (ast:g-get 'openings (ast:g-solve route (ast:n-put 'continuous (list range) settings) nil) nil) 1e-7)
    "Retired stretch settings cannot bypass protected corners")
  (setq chosen T)
  (foreach value '(1.5 3.0 6.0)
    (setq settings (list (cons 'pitch value))
          ;; Independent shallow-turn formula from docs/JUNCTIONS.md.
          before (* 2.0 (atan (/ (* 0.75 (sin (* pi (/ 40.0 180.0))))
            (- (* 1.1 value) (* 0.75 (cos (* pi (/ 40.0 180.0)))))))))
    (foreach angle-value (list (- before 0.0001) (+ before 0.0001) (/ pi 2.0))
      (setq route (list (cons 'primitives (list (ast:c-line '(0.0 100.0) '(0.0 0.0))
              (ast:c-line '(0.0 0.0) (list (* 100.0 (sin angle-value)) (* -100.0 (cos angle-value)))))))
            point (ast:g-continuous-points route settings))
      (if (not (eq (if point T nil) (< angle-value before))) (setq chosen nil))))
  (ast:c-check chosen "Automatic fitting uses the existing profile-dependent shallow-turn bound")
  (setq settings '((pitch . 3.0)) route (ast:c-route)
        result (ast:g-solve route (append '((start . 0.3) (end . 11.8)) settings) nil)
        primitive (list '(kind . chain) (cons 'parts (ast:g-get 'primitives route nil))))
  (ast:c-check (and (ast:c-valid result 3.0)
    (equal (ast:g-get 'center (car (ast:g-get 'openings result nil)) nil) (ast:g-point primitive 0.3) 1e-8)
    (equal (ast:g-get 'center (last (ast:g-get 'openings result nil)) nil) (ast:g-point primitive 11.8) 1e-8))
    "Existing Start and End alone bound automatic fitting")
  (setq result (ast:g-solve (ast:c-route) (ast:n-put 'margin 10.0 settings) nil))
  (ast:c-check (not (ast:g-get 'ok result nil)) "Continuous fitting still rejects insufficient opening clearance")
  (setq result (ast:g-solve (ast:c-route) (ast:n-put 'corrections nil settings) nil))
  (ast:c-check (not (ast:g-get 'ok result nil)) "Disabling corrections rejects a continuous span that needs adjusted spacing")
  (list (cons 'ok (null ast:c-failures)) (cons 'count ast:c-count) (cons 'failures (reverse ast:c-failures))))

(defun ast:c-polyline (offset / points)
  (setq points (mapcar '(lambda (point) (cons 10 (list (car point) (+ offset (cadr point)))))
    '((0.0 0.0) (2.0 0.0) (4.0 0.1) (12.0 1.0))))
  (entmakex (append '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (8 . "0") (100 . "AcDbPolyline") (90 . 4) (70 . 0)) points)))
(defun ast:c-cad-tests (/ ast:c-count ast:c-failures units guide settings state route range result output record identity signature target match-result copied partial transformed bad changed original branch)
  (setq ast:c-count 0 units (getvar "INSUNITS")) (setvar "INSUNITS" 4)
  (setq guide (ast:c-polyline 3100.0) settings (ast:cad-default-settings)
        result (ast:cad-generate guide settings nil) output (ast:cad-get 'output result))
  (ast:c-check (and (ast:cad-get 'ok result) output (entget output)
    (not (ast:cad-get 'stale (ast:cad-read guide))))
    "Continuous polylines generate current DWG output with cross-segment thread and spacing labels")
  (setq state (ast:cad-read guide) route (ast:cad-get 'route state)
        partial (append '((start . 0.3) (end . 11.8)) settings)
        result (ast:cad-save-inputs guide partial nil)
        result (ast:cad-generate guide partial nil) output (ast:cad-get 'output result)
        record (ast:cad-record guide) identity (ast:cad-stitch-id guide) signature (ast:cad-output-signature output)
        result (ast:cad-remove-stitches guide))
  (ast:c-check (and (ast:cad-get 'ok result) (null (entget output))
    (equal partial (ast:cad-get 'settings (ast:cad-read guide))))
    "Removing output preserves the existing Start and End settings")
  (vl-cmdf "_.UNDO" 1)
  (ast:c-check (and (entget output) (equal record (ast:cad-record guide)))
    "Undo restores continuous output and exact guide metadata")
  (vl-cmdf "_.REDO")
  (setq result (ast:cad-generate guide partial nil) output (ast:cad-get 'output result))
  (ast:c-check (and (ast:cad-get 'ok result) (equal identity (ast:cad-stitch-id guide))
    (equal signature (ast:cad-output-signature output)))
    "Regeneration after Redo reproduces the same continuous geometry and stitch ID")
  (setq result (ast:cad-generate guide (ast:cad-put 'margin 100.0 partial) nil))
  (ast:c-check (and (not (ast:cad-get 'ok result)) (entget output)
    (equal signature (ast:cad-output-signature output)))
    "Failed automatic fitting preserves valid output")
  (setq original (entget guide) changed (subst '(10 2.0 3100.02) '(10 2.0 3100.0) original))
  (entmod changed)
  (setq result (ast:cad-generate guide settings nil))
  (ast:c-check (and (ast:cad-get 'ok result)
    (not (ast:cad-get 'range-conflict (ast:cad-read guide))))
    "Reshaping a curve needs no separate stretch repair")
  (entmod original)
  (setq target (ast:c-polyline 3150.0) match-result (ast:match-link guide target 1 nil))
  (ast:c-check (and (ast:cad-get 'ok match-result)
    (ast:cad-get 'ok (ast:cad-generate guide partial nil))
    (not (ast:cad-get 'stale (ast:cad-read target))))
    "Matched guides transfer automatic fitting and the existing stitch limits")
  (setq copied (ast:cad-get 'output (ast:cad-read target)) result (ast:cad-remove-stitches target))
  (ast:c-check (and (ast:cad-get 'ok result) (null (entget copied))
    (ast:cad-get 'active (ast:match-info target))
    (ast:cad-get 'ok (ast:cad-generate guide partial nil))
    (ast:cad-get 'output (ast:cad-read target)))
    "Removing matched continuous output preserves links and allows family regeneration")
  (setq guide (ast:c-polyline 3200.0) settings (ast:cad-default-settings)
        result (ast:cad-generate guide settings nil) output (ast:cad-get 'output result)
        record (ast:cad-record guide) ast:*cad-fail-stage* "guide-metadata"
        result (ast:cad-generate guide settings nil) ast:*cad-fail-stage* nil)
  (ast:c-check (and (not (ast:cad-get 'ok result)) (entget output) (equal record (ast:cad-record guide)))
    "Failed continuous output replacement rolls back geometry and saved settings")
  (setq result (ast:cad-guide-layer guide))
  (ast:c-check (and (ast:cad-get 'ok result) (equal "AUTOSTITCH_GUIDES" (cdr (assoc 8 (entget guide))))
    (ast:cad-get 'ok (ast:cad-generate guide settings nil)))
    "Continuous guides work on the optional dedicated guide layer")
  (setq state (ast:cad-read guide) output (ast:cad-get 'output state)
        record (ast:cad-put 'settings (ast:cad-put 'continuous
          '(((start (primitive . 999) (station . 0.0)) (end (primitive . 999) (station . 1.0)))) settings)
          (ast:cad-record guide)))
  (ast:cad-write-record guide (vl-remove-if '(lambda (item) (eq (car item) 'link)) record) output)
  (ast:cad-write-record output (vl-remove-if '(lambda (item) (member (car item) '(fit-version link))) (ast:cad-record output)) guide)
  (setq state (ast:cad-read guide))
  (ast:c-check (and (not (assoc 'continuous (ast:cad-get 'settings state)))
    (not (ast:cad-get 'range-conflict state)) (entget output))
    "Retired stretch metadata is ignored without repair prompts or output deletion")
  (ast:c-check (ast:cad-get 'stale state)
    "Output from the previous fitting rules remains visible and is marked stale")
  (setq result (ast:cad-generate guide (ast:cad-get 'settings state) nil) state (ast:cad-read guide))
  (ast:c-check (and (ast:cad-get 'ok result) (not (ast:cad-get 'stale state))
    (not (assoc 'continuous (ast:cad-get 'settings (ast:cad-record guide)))))
    "Regeneration removes retired stretch settings and records the current fitting rules")
  (setvar "INSUNITS" units)
  (list (cons 'ok (null ast:c-failures)) (cons 'count ast:c-count) (cons 'failures (reverse ast:c-failures))))

(defun ast:c-ui-tests (/ ast:c-count ast:c-failures units guide settings state result original)
  (setq ast:c-count 0 units (getvar "INSUNITS")) (setvar "INSUNITS" 4)
  (ast:ui-open)
  (setq guide (ast:c-polyline 3300.0) settings (ast:cad-default-settings))
  (ast:cad-save-inputs guide settings nil)
  (ast:ui-adopt (ast:cad-read guide))
  (ast:ui-range-save 'start '(0.3 3300.0 0.0) 3.0)
  (ast:ui-range-save 'end '(11.8 3300.9775 0.0) 3.0)
  (ast:ui-generate)
  (setq state (ast:cad-read guide))
  (ast:c-check (and (ast:cad-get 'output state) (not (ast:cad-get 'stale state))
    (not (assoc 'continuous (ast:cad-get 'settings state)))
    (> (ast:cad-get 'start (ast:cad-get 'settings state)) 0.0))
    "Select guide then Start End and Generate fits a curve without another mode")
  (setq guide (ast:c-polyline 3350.0))
  (ast:cad-save-inputs guide settings '(((primitive . 0) (station . 0.5)) ((primitive . 2) (station . 3.0))))
  (setq original (entget guide))
  (entmod (subst '(10 2.0 3351.0) '(10 2.0 3350.0) original))
  (ast:ui-adopt (ast:cad-read guide))
  (setq astui:*index* 0)
  (c:ASTUIDELETE)
  (setq state (ast:cad-read guide))
  (ast:c-check (and (equal (ast:cad-get 'landmarks state) '(((primitive . 2) (station . 3.0))))
    (ast:cad-attachments-valid-p state (ast:cad-get 'landmarks state)))
    "Delete removes only the selected invalid landmark and preserves an unchanged segment landmark")
  (ast:ui-clear) (ast:ui-fill) (setvar "INSUNITS" units)
  (list (cons 'ok (null ast:c-failures)) (cons 'count ast:c-count) (cons 'failures (reverse ast:c-failures))))
(princ)
