;;; Load core first. (ast:g-tests) returns a result alist and does not touch CAD.
(defun ast:g-test (condition label)
  (setq ast:g-test-count (1+ ast:g-test-count))
  (if (not condition) (setq ast:g-test-failures (cons label ast:g-test-failures))))
(defun ast:g-test-guide (radius sigma tangent-angle extent incoming / tangent center radial angle)
  (setq tangent (list (cos tangent-angle) (sin tangent-angle)))
  (if (= radius 0)
    (if incoming (list '(kind . line) (cons 'a (ast:g-mul tangent (- extent))) '(b 0.0 0.0))
      (list '(kind . line) '(a 0.0 0.0) (cons 'b (ast:g-mul tangent extent))))
    (progn
      (setq center (ast:g-mul (ast:g-left tangent) (* sigma radius)) radial (ast:g-mul (ast:g-left tangent) (- sigma))
            angle (atan (cadr radial) (car radial)))
      (list '(kind . arc) (cons 'center center) (cons 'radius radius)
            (cons 'start-angle (if incoming (- angle (* sigma (/ extent radius))) angle)) (cons 'sweep (* sigma (/ extent radius)))))))
;; Independent endpoint/tangent evaluation for corner checks: no production locus,
;; station recovery, point, tangent, or slit builder is used here.
(defun ast:g-test-corner-slit (radius sigma tangent station / angle center)
  (setq angle (+ tangent (if (= radius 0.0) 0.0 (* sigma (/ station radius)))))
  (setq center
    (if (= radius 0.0) (list (* station (cos tangent)) (* station (sin tangent)))
      (list (+ (* (- sigma) radius (sin tangent)) (* sigma radius (sin angle)))
            (- (* sigma radius (cos tangent)) (* sigma radius (cos angle))))))
  (list center (list (cos (+ angle (* pi (/ 40.0 180.0)))) (sin (+ angle (* pi (/ 40.0 180.0)))))))
(defun ast:g-test-chord-station (radius pitch)
  (if (= radius 0.0) pitch (* 2.0 radius (atan pitch (sqrt (- (* 4.0 radius radius) (* pitch pitch)))))))
(defun ast:g-test-corner-matrix (/ pitch hand degrees angle settings incoming outgoing corner expected point label radius-in radius-out sigma-in sigma-out extent-in extent-out station-in station-out before after virtual-in virtual-out joint route result reversed-result)
  ;; Closed-form line intersection, independently of the production generic loci.
  (foreach pitch '(2.7 3.0 3.38 3.85)
    (foreach hand '(-1 1)
      (foreach degrees '(-150 -135 -120 -90 -60 -45 -30 30 45 60 90 120 135 150)
        (setq angle (* pi (/ degrees 180.0))
              settings (list (cons 'pitch pitch) (cons 'handedness hand))
              incoming (ast:g-test-guide 0.0 1 0.0 30.0 T)
              outgoing (ast:g-test-guide 0.0 1 angle 30.0 nil)
              corner (ast:g-corner incoming outgoing settings)
              label (strcat "line corner p=" (rtos pitch 2 2) " turn=" (itoa degrees) " hand=" (itoa hand))
              expected (list (/ (* -0.75 hand (sin (* pi (/ 40.0 180.0))) (cos (/ angle 2.0))) (sin (/ angle 2.0)))
                             (* -0.75 hand (sin (* pi (/ 40.0 180.0))))))
        (ast:g-test (ast:g-get 'ok corner nil) (strcat label " accepted"))
        (if (ast:g-get 'ok corner nil)
          (progn
            (setq point (ast:g-get 'center (ast:g-get 'opening corner nil) nil))
            (ast:g-test (equal point expected 1e-8) (strcat label " closed-form hole"))
            (ast:g-test (and (equal (ast:g-get 'incoming-station corner nil)
                                   (+ 30.0 (car expected) (* 0.75 (cos (* pi (/ 40.0 180.0)))) (- pitch)) 1e-8)
                             (equal (ast:g-get 'outgoing-station corner nil)
                                    (+ (* (car expected) (cos angle)) (* (cadr expected) (sin angle)) (- (* 0.75 (cos (* pi (/ 40.0 180.0))))) pitch) 1e-8))
                        (strcat label " nominal virtual-to-real neighbours")))))))
  ;; The 48 mixed-curve cases check the selected-tip recipe, not the HTML's older
  ;; A03/A04 shared-endpoint recipe. Those deliberately different results must not
  ;; be counted as matches to the original fixtures.
  (foreach degrees '(-135 -90 -45 45 90 135)
    (foreach radius-in '(0.0 10.0)
      (foreach radius-out '(0.0 8.0)
        (if (or (> radius-in 0.0) (> radius-out 0.0))
          (foreach sigma-in (if (= radius-in 0.0) '(1) '(-1 1))
            (foreach sigma-out (if (= radius-out 0.0) '(1) '(-1 1))
              (setq angle (* pi (/ degrees 180.0))
                    extent-in (if (= radius-in 0.0) 10.0 (* radius-in (/ pi 3.0)))
                    extent-out (if (= radius-out 0.0) 10.0 (* radius-out (/ pi 3.0)))
                    incoming (ast:g-test-guide radius-in sigma-in 0.0 extent-in T)
                    outgoing (ast:g-test-guide radius-out sigma-out angle extent-out nil)
                    corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)))
                    label (strcat "curved corner " (rtos radius-in 2 0) "/" (rtos radius-out 2 0) " turn=" (itoa degrees)
                                  " winding=" (itoa sigma-in) "/" (itoa sigma-out)))
              (ast:g-test (ast:g-get 'ok corner nil) (strcat label " accepted"))
              (if (ast:g-get 'ok corner nil)
                (progn
                  (setq station-in (- (ast:g-get 'incoming-station corner 0.0) extent-in)
                        station-out (ast:g-get 'outgoing-station corner 0.0)
                        before (ast:g-test-corner-slit radius-in sigma-in 0.0 station-in)
                        after (ast:g-test-corner-slit radius-out sigma-out angle station-out)
                        virtual-in (ast:g-test-corner-slit radius-in sigma-in 0.0 (+ station-in (ast:g-test-chord-station radius-in 3.0)))
                        virtual-out (ast:g-test-corner-slit radius-out sigma-out angle (- station-out (ast:g-test-chord-station radius-out 3.0)))
                        joint (ast:g-get 'center (ast:g-get 'opening corner nil) nil))
                  (ast:g-test (and (>= station-in (- (- extent-in) 1e-8)) (<= station-in 1e-8)
                                   (>= station-out -1e-8) (<= station-out (+ extent-out 1e-8))) (strcat label " finite arms"))
                  (ast:g-test (and (equal (distance (car before) (car virtual-in)) 3.0 1e-8)
                                   (equal (distance (car after) (car virtual-out)) 3.0 1e-8)) (strcat label " direct chord pitch"))
                  (ast:g-test (and (equal joint (mapcar '- (car virtual-in) (mapcar '(lambda (value) (* 0.75 value)) (cadr virtual-in))) 1e-8)
                                   (equal joint (mapcar '+ (car virtual-out) (mapcar '(lambda (value) (* 0.75 value)) (cadr virtual-out))) 1e-8))
                              (strcat label " independently reconstructed selected tips"))
                  (setq route (list (cons 'primitives
                                    (list (ast:g-test-guide radius-in sigma-in 0.0 (- station-in) T)
                                          (ast:g-test-guide radius-out sigma-out angle station-out nil))))
                        result (ast:g-solve route '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)) nil))
                  (ast:g-test (and (ast:g-get 'ok result nil) (= 3 (length (ast:g-get 'openings result nil)))
                                   (= 2 (length (ast:g-get 'intervals result nil))))
                              (strcat label " full route ending at reserved neighbours: " (ast:g-get 'error result "")))
                  (setq reversed-result (ast:g-solve route '((pitch . 3.0) (thickness . 0.2) (margin . 0.2) (reverse . T)) nil))
                  (ast:g-test (and (ast:g-get 'ok result nil) (ast:g-get 'ok reversed-result nil)
                                   (= 3 (length (ast:g-get 'openings reversed-result nil)))
                                   (not (member nil (mapcar 'ast:g-same-opening (reverse (ast:g-get 'openings result nil))
                                                                          (ast:g-get 'openings reversed-result nil)))))
                              (strcat label " reversed route preserves physical openings: " (ast:g-get 'error reversed-result "")))))))))))
  (setq incoming (ast:g-test-guide 3.0 1 0.0 (* 3.0 (/ pi 2.0)) T)
        outgoing (ast:g-test-guide 3.0 1 (- (/ pi 4.0)) (* 3.0 (/ pi 2.0)) nil)
        corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
  (ast:g-test (ast:g-get 'ok corner nil) "R3 same winding 45 degree turn admits local corner")
  ;; Here the support centres are 6 cos(pi/8)=5.543277195 mm apart,
  ;; while the two selected-tip locus radii sum to only 5.165251497 mm.
  (setq incoming (ast:g-test-guide 3.0 -1 0.0 (* 3.0 (/ pi 2.0)) T)
        corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
  (ast:g-test (and (not (ast:g-get 'ok corner nil)) (wcmatch (ast:g-get 'error corner "") "*no isolated tip-locus intersection*"))
              "R3 opposite winding same 45 degree turn rejects disjoint loci")
  (setq outgoing (ast:g-test-guide 3.0 -1 (* pi -0.75) (* 3.0 (/ pi 2.0)) nil)
        corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
  (ast:g-test (and (not (ast:g-get 'ok corner nil)) (wcmatch (ast:g-get 'error corner "") "*clearance rejected*"))
              "R3 same winding 135 degree turn rejects crossing real slit axes")
  (foreach degrees '(-180 -170 -160 160 170 180)
    (setq corner (ast:g-corner (ast:g-test-guide 0.0 1 0.0 30.0 T)
                               (ast:g-test-guide 0.0 1 (* pi (/ degrees 180.0)) 30.0 nil)
                               '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
    (ast:g-test (not (ast:g-get 'ok corner nil)) (strcat "clearance or reversal rejects turn " (itoa degrees))))
  (foreach degrees '(-159.565 159.565)
    (setq corner (ast:g-corner (ast:g-test-guide 0.0 1 0.0 30.0 T)
                               (ast:g-test-guide 0.0 1 (* pi (/ degrees 180.0)) 30.0 nil)
                               '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
    (ast:g-test (ast:g-get 'ok corner nil) (strcat "20.435 degree included angle clears 0.4 mm: " (rtos degrees 2 3))))
  (foreach degrees '(-159.566 159.566)
    (setq corner (ast:g-corner (ast:g-test-guide 0.0 1 0.0 30.0 T)
                               (ast:g-test-guide 0.0 1 (* pi (/ degrees 180.0)) 30.0 nil)
                               '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
    (ast:g-test (not (ast:g-get 'ok corner nil)) (strcat "20.434 degree included angle fails 0.4 mm: " (rtos degrees 2 3))))
  (foreach degrees '(-22.4833 22.4833)
    (setq corner (ast:g-corner (ast:g-test-guide 0.0 1 0.0 30.0 T)
                               (ast:g-test-guide 0.0 1 (* pi (/ degrees 180.0)) 30.0 nil) '((pitch . 3.0))))
    (ast:g-test (not (ast:g-get 'ok corner nil)) (strcat "shallow turn neighbour leaves arm: " (rtos degrees 2 4))))
  (foreach degrees '(-22.4836 22.4836)
    (setq corner (ast:g-corner (ast:g-test-guide 0.0 1 0.0 30.0 T)
                               (ast:g-test-guide 0.0 1 (* pi (/ degrees 180.0)) 30.0 nil) '((pitch . 3.0))))
    (ast:g-test (ast:g-get 'ok corner nil) (strcat "shallow turn neighbour fits arm: " (rtos degrees 2 4)))))
(defun ast:g-test-rigid-point (point angle offset)
  (list (+ (car offset) (- (* (car point) (cos angle)) (* (cadr point) (sin angle))))
        (+ (cadr offset) (* (car point) (sin angle)) (* (cadr point) (cos angle)))))
(defun ast:g-test-rigid-primitive (primitive angle offset)
  (if (= (ast:g-get 'kind primitive nil) 'line)
    (list '(kind . line) (cons 'a (ast:g-test-rigid-point (ast:g-get 'a primitive nil) angle offset))
                       (cons 'b (ast:g-test-rigid-point (ast:g-get 'b primitive nil) angle offset)))
    (list '(kind . arc) (cons 'center (ast:g-test-rigid-point (ast:g-get 'center primitive nil) angle offset))
                       (cons 'radius (ast:g-get 'radius primitive nil))
                       (cons 'start-angle (+ (ast:g-get 'start-angle primitive nil) angle))
                       (cons 'sweep (ast:g-get 'sweep primitive nil)))))
(defun ast:g-test-rigid-opening (opening angle offset / transformed)
  (setq transformed (subst (cons 'center (ast:g-test-rigid-point (ast:g-get 'center opening nil) angle offset))
                           (assoc 'center opening) opening))
  (if (= (ast:g-get 'type opening nil) 'slit)
    (setq transformed (subst (cons 'axis (ast:g-test-rigid-point (ast:g-get 'axis opening nil) angle '(0.0 0.0)))
                             (assoc 'axis opening) transformed)))
  transformed)
;; Separate entry point for focused runs; also included by ast:g-tests below.
(defun ast:g-test-corner-transforms (/ ast:g-test-count ast:g-test-failures degrees radius-in radius-out sigma-in sigma-out angle extent-in extent-out incoming outgoing corner station-in station-out route baseline transform rotation offset transformed expected result label)
  (setq ast:g-test-count 0 ast:g-test-failures nil)
  (foreach degrees '(-135 -90 -45 45 90 135)
    (foreach radius-in '(0.0 10.0)
      (foreach radius-out '(0.0 8.0)
        (if (or (> radius-in 0.0) (> radius-out 0.0))
          (foreach sigma-in (if (= radius-in 0.0) '(1) '(-1 1))
            (foreach sigma-out (if (= radius-out 0.0) '(1) '(-1 1))
              (setq angle (* pi (/ degrees 180.0))
                    extent-in (if (= radius-in 0.0) 10.0 (* radius-in (/ pi 3.0)))
                    extent-out (if (= radius-out 0.0) 10.0 (* radius-out (/ pi 3.0)))
                    incoming (ast:g-test-guide radius-in sigma-in 0.0 extent-in T)
                    outgoing (ast:g-test-guide radius-out sigma-out angle extent-out nil)
                    corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)))
                    station-in (- (ast:g-get 'incoming-station corner 0.0) extent-in)
                    station-out (ast:g-get 'outgoing-station corner 0.0)
                    route (list (ast:g-test-guide radius-in sigma-in 0.0 (- station-in) T)
                                (ast:g-test-guide radius-out sigma-out angle station-out nil))
                    baseline (ast:g-solve (list (cons 'primitives route)) '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)) nil)
                    label (strcat "rigid corner " (rtos radius-in 2 0) "/" (rtos radius-out 2 0) " turn=" (itoa degrees)
                                  " winding=" (itoa sigma-in) "/" (itoa sigma-out)))
              (ast:g-test (and (ast:g-get 'ok baseline nil) (= 3 (length (ast:g-get 'openings baseline nil)))) (strcat label " baseline"))
              (foreach transform '((0.37 (0.0 0.0)) (0.37 (123.4 -56.7)) (0.37 (1000.0 1000.0)))
                (setq rotation (car transform) offset (cadr transform)
                      transformed (mapcar '(lambda (item) (ast:g-test-rigid-primitive item rotation offset)) route)
                      expected (mapcar '(lambda (item) (ast:g-test-rigid-opening item rotation offset)) (ast:g-get 'openings baseline nil))
                      result (ast:g-solve (list (cons 'primitives transformed)) '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)) nil))
                (ast:g-test (and (ast:g-get 'ok result nil) (= 3 (length (ast:g-get 'openings result nil)))
                                 (= 2 (length (ast:g-get 'intervals result nil))))
                            (strcat label " moved " (vl-princ-to-string offset) ": " (ast:g-get 'error result "")))
                (ast:g-test (and (= 3 (length expected)) (= 3 (length (ast:g-get 'openings result nil)))
                                 (not (member nil (mapcar 'ast:g-same-opening expected (ast:g-get 'openings result nil)))))
                            (strcat label " transformed centres/types/axes " (vl-princ-to-string offset))))))))))
  (list (cons 'ok (null ast:g-test-failures)) (cons 'checks ast:g-test-count) (cons 'failures (reverse ast:g-test-failures))))
(defun ast:g-tests (/ ast:g-test-count ast:g-test-failures result route settings original split incoming outgoing corner sigma-in sigma-out turn opening virtual-before virtual-after root first-cut other-cut width-settings)
  (setq ast:g-test-count 0 ast:g-test-failures nil)
  (ast:g-test-corner-matrix)
  (setq result (ast:g-test-corner-transforms)
        ast:g-test-count (+ ast:g-test-count (ast:g-get 'checks result 0))
        ast:g-test-failures (append (reverse (ast:g-get 'failures result nil)) ast:g-test-failures))
  (setq route '((kind . line) (a 0.0 0.0) (b 30.0 0.0)))
  (setq result (ast:g-solve-primitive route '((pitch . 3.0)) nil 1.0 (+ 1.0 1e-15)))
  (ast:g-test (and (ast:g-get 'ok result nil) (= 1 (length (ast:g-get 'openings result nil)))
                   (null (ast:g-get 'intervals result nil))
                   (equal '(1.0 0.0) (ast:g-get 'center (car (ast:g-get 'openings result nil)) nil) 1e-14))
              "arithmetic-near anchors reuse one opening without interval")
  (setq result (ast:g-solve-primitive route '((pitch . 3.0)) nil 1.0 (+ 1.0 1e-8)))
  (ast:g-test (and (not (ast:g-get 'ok result nil)) (wcmatch (ast:g-get 'error result "") "Infeasible span*"))
              "genuinely positive 1e-8 span is not collapsed into one opening")
  (setq result (ast:g-solve-primitive '((kind . line) (a 1000.0 1000.0) (b 1030.0 1000.0))
                                     '((pitch . 3.0)) nil 1.0 (+ 1.0 1e-8)))
  (ast:g-test (and (not (ast:g-get 'ok result nil)) (wcmatch (ast:g-get 'error result "") "Infeasible span*"))
              "translated genuinely positive 1e-8 span still rejects at world offset1000")
  (setq result (ast:g-solve (list (cons 'primitives (list route))) '((pitch . 3.0))
                            '(((primitive . 0) (station . 10.1)) ((primitive . 0) (station . 13.1)))))
  (ast:g-test (and (ast:g-get 'ok result nil)
                   (= 1 (length (vl-remove-if-not '(lambda (item) (equal (ast:g-get 'center item nil) '(11.6 0.0) 1e-8)) (ast:g-get 'openings result nil))))
                   (= 2 (length (vl-remove-if-not '(lambda (item) (and (ast:g-get 'reserved item nil) (equal (ast:g-get 'distance item 0.0) 3.0 1e-8))) (ast:g-get 'intervals result nil))))
                   (= (length (ast:g-get 'intervals result nil)) (1- (length (ast:g-get 'openings result nil)))))
              "adjacent landmark gaps share one opening and both retain nominal pitch")
  (setq result (ast:g-fit-line 30.5 3.0 0 0 T))
  (ast:g-test (and (= (cdr (assoc 'count result)) 10) (= (cdr (assoc 'changed result)) 2) (= (cdr (assoc 'block-start result)) 4)) "30.5 central two gaps")
  (setq result (ast:g-fit-line 31.5 3.0 0 0 T))
  (ast:g-test (and (= (cdr (assoc 'count result)) 11) (= (cdr (assoc 'changed result)) 5) (= (cdr (assoc 'block-start result)) 3)) "31.5 symmetric count tie")
  (setq result (ast:g-fit-line 30.3 3.0 0 0 T))
  (ast:g-test (= (cdr (assoc 'block-start result)) 5) "half index tie toward end")
  (setq result (ast:g-fit-line 6.3 3.0 0 1 T))
  (ast:g-test (equal (cdr (assoc 'gaps result)) '(3.3 3.0) 1e-8) "protected final gap")
  (ast:g-test (not (cdr (assoc 'ok (ast:g-fit-line 7.0 3.0 0 0 T)))) "infeasible seven")
  (ast:g-test (not (cdr (assoc 'ok (ast:g-fit-line 30.5 3.0 0 0 nil)))) "disabled corrections")
  (setq route '((primitives ((kind . line) (a 0.0 0.0) (b 30.0 0.0)))) settings '((pitch . 3.0)))
  (setq result (ast:g-solve route settings nil))
  (ast:g-test (and (cdr (assoc 'ok result)) (= (length (cdr (assoc 'openings result))) 11)) "line eleven openings")
  (setq result (ast:g-solve route settings '(((primitive . 0) (station . 16.5)))))
  (ast:g-test (and (cdr (assoc 'ok result)) (= (length (cdr (assoc 'openings result))) 11)) "landmark centred nominal gap")
  (setq result (ast:g-solve route '((pitch . 3.0) (slit-length . 3.0) (thickness . 0.2) (margin . 0.2)) nil))
  (ast:g-test (cdr (assoc 'ok result)) "finite footprint replaces length-only guard")
  (setq result (ast:g-fit-arc 10.0 (/ pi 2.0) 3.0 0 0 T))
  (ast:g-test (cdr (assoc 'ok result)) "quarter circle chord fit")
  (setq original (ast:g-solve route settings nil)
        split '((primitives ((kind . line) (a 0.0 0.0) (b 11.0 0.0)) ((kind . line) (a 11.0 0.0) (b 30.0 0.0))))
        result (ast:g-solve split settings nil))
  (ast:g-test (equal (ast:g-get 'openings result nil) (ast:g-get 'openings original nil) 1e-8) "redundant line vertex normalized")
  (setq result (ast:g-solve route '((pitch . 3.0) (reverse . T)) '(((primitive . 0) (station . 16.5)))))
  (ast:g-test (and (ast:g-get 'ok result nil) (equal (ast:g-get 'center (car (ast:g-get 'openings result nil)) nil) '(30.0 0.0) 1e-8)) "reverse with fixed native landmark")
  (setq incoming '((kind . line) (a -30.0 0.0) (b 0.0 0.0)) outgoing '((kind . line) (a 0.0 0.0) (b 0.0 -30.0)))
  (setq corner (ast:g-corner incoming outgoing settings))
  (ast:g-test (ast:g-get 'ok corner nil) "sharp ninety degree line corner")
  (setq route (list (cons 'primitives (list incoming outgoing))) result (ast:g-solve route settings nil))
  (ast:g-test (and (ast:g-get 'ok result nil) (= 1 (length (vl-remove-if-not '(lambda (item) (= (ast:g-get 'type item nil) 'round)) (ast:g-get 'openings result nil))))) "ordered sharp route emits one round hole")
  (ast:g-test (= (length (ast:g-get 'intervals result nil)) (1- (length (ast:g-get 'openings result nil)))) "open sharp route interval identity")
  (setq route (list (cons 'primitives (list (list '(kind . arc) '(center 0.0 0.0) '(radius . 10.0) '(start-angle . 0.0) (cons 'sweep (* 2.0 pi))))) '(closed . T))
        result (ast:g-solve route settings nil))
  (ast:g-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) (length (ast:g-get 'intervals result nil)))) "circle closure reuses first identity")
  (setq result (ast:g-solve route '((pitch . 3.0) (phase . 5.0)) nil))
  (ast:g-test (equal (ast:g-get 'center (car (ast:g-get 'openings result nil)) nil) (list (* 10.0 (cos 0.5)) (* 10.0 (sin 0.5))) 1e-8) "circle picked phase")
  (setq route '((primitives ((kind . line) (a 0.0 0.0) (b 40.0 0.0)))) result (ast:g-solve route '((pitch . 3.0) (start . 4.0) (end . 34.0)) nil))
  (ast:g-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) 11) (equal (ast:g-get 'center (car (ast:g-get 'openings result nil)) nil) '(4.0 0.0) 1e-8)) "native start end trim")
  (setq route '((primitives ((kind . line) (a 0.0 0.0) (b 30.0 30.0)) ((kind . line) (a 30.0 30.0) (b 0.0 30.0)) ((kind . line) (a 0.0 30.0) (b 30.0 0.0)))))
  (ast:g-test (not (ast:g-get 'ok (ast:g-solve route settings nil) nil)) "self crossing rejected")
  (setq incoming (list '(kind . arc) '(center 0.0 -10.0) '(radius . 10.0) (cons 'start-angle (+ (/ pi 2.0) (/ pi 3.0))) (cons 'sweep (- (/ pi 3.0))))
        outgoing '((kind . line) (a 0.0 0.0) (b 0.0 -30.0)) corner (ast:g-corner incoming outgoing settings))
  (ast:g-test (and (ast:g-get 'ok corner nil) (equal (ast:g-get 'center (ast:g-get 'opening corner nil) nil) '(0.482090909 -0.476960588) 1e-6)) "A03 reflected independent tip locus fixture")
  (foreach turn (list (/ pi 2.0) (- (/ pi 2.0)))
    (foreach sigma-in '(-1 1)
      (foreach sigma-out '(-1 1)
        (setq incoming (ast:g-test-guide 10.0 sigma-in 0.0 (* 10.0 (/ pi 3.0)) T)
              outgoing (ast:g-test-guide 8.0 sigma-out turn (* 8.0 (/ pi 3.0)) nil)
              corner (ast:g-corner incoming outgoing '((pitch . 3.0) (thickness . 0.2) (margin . 0.2))))
        (ast:g-test (ast:g-get 'ok corner nil) "arc arc local corner winding and turn matrix")
        (if (ast:g-get 'ok corner nil)
          (progn
            (setq opening (ast:g-get 'opening corner nil)
