;;; Run only in a disposable test drawing; these tests create and copy entities.
(defun ast:host-tests (/ ast:*cad-test-passed* ast:*cad-test-failures* original-units original-copy original-tile settings guide output result selection before cursor copied-guide copied-output original-name data paper-guide document)
  (setq ast:*cad-test-passed* 0 ast:*cad-test-failures* nil
        original-units (getvar "INSUNITS") original-copy (getvar "COPYMODE") original-tile (getvar "TILEMODE")
        document (vla-get-ActiveDocument (vlax-get-acad-object)) settings (ast:cad-default-settings))
  (setvar "INSUNITS" 4) (setvar "COPYMODE" 1) (setvar "TILEMODE" 1)
  (setq guide (entmakex '((0 . "LINE") (8 . "0") (10 0.0 300.0 0.0) (11 30.0 300.0 0.0)))
        result (ast:cad-generate guide settings nil) output (ast:cad-get 'output result)
        original-name (cdr (assoc 2 (entget output))) selection (ssadd guide))
  (ssadd output selection)
  (setq before (entlast))
  (vl-cmdf "_.COPY" selection "" "_non" '(0.0 0.0 0.0) "_non" '(60.0 0.0 0.0))
  (setq cursor (entnext before))
  (while cursor
    (cond ((= "LINE" (cdr (assoc 0 (entget cursor)))) (setq copied-guide cursor))
          ((= "INSERT" (cdr (assoc 0 (entget cursor)))) (setq copied-output cursor)))
    (setq cursor (entnext cursor)))
  (ast:cad-test-assert (and copied-guide copied-output
    (equal copied-output (ast:cad-get 'output (ast:cad-read copied-guide)))
    (equal copied-guide (ast:cad-get 'guide (ast:cad-read copied-output))))
    "Native COPY both remaps reciprocal references")
  (ast:cad-test-assert (and (ast:cad-get 'common-placement (ast:cad-read copied-guide))
    (not (ast:cad-get 'stale (ast:cad-read copied-guide)))) "Copied pair translation remains current")
  (setq result (ast:cad-generate copied-guide settings nil))
  (ast:cad-test-assert (and (ast:cad-get 'ok result)
    (equal original-name (cdr (assoc 2 (entget output))))
    (/= original-name (cdr (assoc 2 (entget copied-output))))) "Copied pair regenerates independently")
  (setq guide (entmakex '((0 . "LINE") (8 . "0") (10 0.0 350.0 0.0) (11 30.0 350.0 0.0))))
  (setvar "TILEMODE" 0)
  (setq result (ast:cad-generate guide settings nil) output (ast:cad-get 'output result))
  (ast:cad-test-assert (and (ast:cad-get 'ok result)
    (equal (cdr (assoc 330 (entget guide))) (cdr (assoc 330 (entget output)))))
    "Model guide creates model output while paper space is active")
  (setq paper-guide (vlax-vla-object->ename (vla-AddLine (vla-get-PaperSpace document)
    (vlax-3d-point '(10.0 10.0 0.0)) (vlax-3d-point '(40.0 10.0 0.0)))))
  (setvar "TILEMODE" 1)
  (setq result (ast:cad-generate paper-guide settings nil) output (ast:cad-get 'output result))
  (ast:cad-test-assert (and (ast:cad-get 'ok result)
    (equal (cdr (assoc 330 (entget paper-guide))) (cdr (assoc 330 (entget output)))))
    "Paper guide creates paper output while model space is active")
  (setvar "INSUNITS" original-units) (setvar "COPYMODE" original-copy) (setvar "TILEMODE" original-tile)
  (list (cons 'passed ast:*cad-test-passed*) (cons 'failed (length ast:*cad-test-failures*))
        (cons 'failures (reverse ast:*cad-test-failures*))))
(princ)

;;; Run separately after loading the current UI and compiled palette.
(defun ast:ui-test-enabled-p (control)
  (member (dcl-Control-GetProperty "AUTOSTITCH" "Palette" control "Enabled") '(T 1 -1)))

(defun ast:ui-tests (/ ast:*cad-test-passed* ast:*cad-test-failures* original-units original-tile settings guide output result state source-data output-data record generated-data generated-record landmarks partial-settings first second first-data second-data caption)
  (setq ast:*cad-test-passed* 0 ast:*cad-test-failures* nil
        original-units (getvar "INSUNITS") original-tile (getvar "TILEMODE")
        settings (ast:cad-default-settings))
  (setvar "INSUNITS" 4) (setvar "TILEMODE" 1)
  (c:AUTOSTITCH)
  (c:ASTUIINIT)
  (ast:cad-test-assert (and (not (ast:ui-test-enabled-p "Generate"))
                          (not (ast:ui-test-enabled-p "Add"))
                          (not (ast:ui-test-enabled-p "Delete")))
    "An empty palette disables actions that require a selected stitch line")
  (setq guide (entmakex '((0 . "LINE") (8 . "0") (10 0.0 1700.0 0.0) (11 30.0 1700.0 0.0)))
        result (ast:cad-generate guide settings nil) output (ast:cad-get 'output result))
  (ast:cad-require output "Could not create the palette generation fixture.")
  (ast:ui-adopt (ast:cad-read guide))
  (setq caption (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Seam" "Caption"))
  (ast:cad-test-assert (and (wcmatch caption "Stitch length:*30*mm*")
                          (null (vl-string-search "|" caption))
                          (not (ast:ui-test-enabled-p "Start")))
    "A normal open guide shows its stitch length without exposing range controls")
  (ast:cad-test-assert (and
    (equal "Add landmark" (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Add" "Caption"))
    (equal "Remove landmark" (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Delete" "Caption")))
    "Landmark actions name both the action and its object")
  (setq source-data (entget guide))
  (entmod (ast:cad-put 10 '(7.0 3.0 0.0) (ast:cad-put 41 2.0
    (ast:cad-put 50 0.3 (entget output)))))
  (setq output-data (entget output) record (ast:cad-record guide))
  (ast:ui-adopt (ast:cad-read guide))
  (ast:ui-put "Pitch" "Text" "not a number")
  (c:ASTUIGENERATE)
  (ast:cad-test-assert (and (equal output-data (entget output))
                          (equal record (ast:cad-record guide)))
    "Generate rejects invalid pitch without restoring or replacing moved output")
  (ast:ui-put "Pitch" "Text" "100")
  (c:ASTUIGENERATE)
  (ast:cad-test-assert (and (equal output-data (entget output))
                          (equal record (ast:cad-record guide)))
    "An infeasible Generate preserves transformed output and its saved pitch")
  (ast:ui-put "Pitch" "Text" "4")
  (c:ASTUIGENERATE)
  (setq state (ast:cad-read guide) generated-data (entget output) generated-record (ast:cad-record guide))
  (ast:cad-test-assert (and (equal source-data (entget guide))
    (equal 4.0 (ast:cad-get 'pitch (ast:cad-get 'settings state)) 1e-10)
    (ast:cad-placement-ok-p output) (not (ast:cad-get 'stale state)))
    "Generate applies the draft pitch and restores moved output to the unchanged guide")
  (vl-cmdf "_.UNDO" 1)
  (ast:cad-test-assert (and (equal output-data (entget output))
                          (equal record (ast:cad-record guide))
                          (equal source-data (entget guide)))
    "One Undo restores the transformed output and previous pitch together")
  (vl-cmdf "_.REDO")
  (ast:cad-test-assert (and (equal generated-data (entget output))
                          (equal generated-record (ast:cad-record guide)))
    "Redo restores the generated output and new pitch together")

  (setq guide (entmakex '((0 . "LINE") (8 . "0") (10 0.0 1750.0 0.0) (11 30.0 1750.0 0.0)))
        landmarks '(((primitive . 0) (station . 16.5)))
        partial-settings (append '((start . 3.0) (end . 27.0)) settings)
        partial-settings (ast:cad-put 'start-anchor
          (ast:cad-range-anchor guide '((primitive . 0) (station . 3.0))) partial-settings)
        partial-settings (ast:cad-put 'end-anchor
          (ast:cad-range-anchor guide '((primitive . 0) (station . 27.0))) partial-settings)
        result (ast:cad-generate guide partial-settings landmarks)
        source-data (entget guide) record (ast:cad-record guide))
  (ast:cad-require (ast:cad-get 'ok result) "Could not create the saved partial-guide fixture.")
  (ast:ui-adopt (ast:cad-read guide))
  (setq caption (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Seam" "Caption"))
  (ast:cad-test-assert (and (equal record (ast:cad-record guide))
    (wcmatch caption "Stitch length:*24*mm*part*")
    (ast:ui-test-enabled-p "Start")
    (equal "Use whole line" (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Start" "Caption")))
    "Selecting a legacy partial guide preserves its inputs and exposes Use whole line")
  (c:ASTUIGENERATE)
  (setq state (ast:cad-read guide))
  (ast:cad-test-assert (and
    (equal 3.0 (ast:cad-get 'start (ast:cad-get 'settings state)) 1e-10)
    (equal 27.0 (ast:cad-get 'end (ast:cad-get 'settings state)) 1e-10)
    (not (ast:cad-get 'stale state)))
    "Generate retains saved partial coverage until Use whole line is chosen")
  (c:ASTUISTART)
  (setq state (ast:cad-read guide))
  (ast:cad-test-assert (and (equal source-data (entget guide))
    (equal landmarks (ast:cad-get 'landmarks state))
    (equal 3.0 (ast:cad-get 'pitch (ast:cad-get 'settings state)) 1e-10)
    (not (vl-some '(lambda (key) (assoc key (ast:cad-get 'settings state)))
      '(start end start-anchor end-anchor)))
    (not (ast:ui-test-enabled-p "Start")))
    "Use whole line clears only the saved limits while retaining guide, pitch and landmark")
  (c:ASTUILANDMARK 0 "Landmark 1")
  (c:ASTUIDELETE)
  (ast:cad-test-assert (and (null (ast:cad-get 'landmarks (ast:cad-read guide)))
                          (not (ast:ui-test-enabled-p "Delete"))
                          (equal source-data (entget guide)))
    "Remove landmark deletes its constraint and disables itself when no landmarks remain")
  (setq partial-settings (ast:cad-put 'end-anchor
          (ast:cad-range-anchor guide '((primitive . 0) (station . 30.0)))
          (ast:cad-put 'end 30.0 settings)))
  (ast:cad-save-inputs guide partial-settings nil)
  (ast:ui-adopt (ast:cad-read guide))
  (ast:cad-test-assert (and (ast:ui-test-enabled-p "Start")
    (equal "Use whole line" (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Start" "Caption")))
    "A saved endpoint anchor still offers conversion even when it currently reaches the full guide")

  (setq guide (entmakex '((0 . "CIRCLE") (8 . "0") (10 100.0 1750.0 0.0) (40 . 10.0))))
  (ast:ui-adopt (ast:cad-read guide))
  (ast:cad-test-assert (and (ast:ui-test-enabled-p "Start")
    (equal "Set loop start" (dcl-Control-GetProperty "AUTOSTITCH" "Palette" "Start" "Caption")))
    "A closed guide retains an explicit loop starting-point action")

  (setq first (entmakex '((0 . "LINE") (8 . "0") (10 -12.0 1800.0 0.0) (11 12.0 1800.0 0.0)))
        second (entmakex '((0 . "LINE") (8 . "0") (10 0.0 1800.0 0.0) (11 0.0 1812.0 0.0)))
        result (ast:cad-connect first second '(0.0 1800.0 0.0) settings nil)
        output (ast:cad-get 'output result) first-data (entget first) second-data (entget second))
  (ast:cad-require output "Could not create the connected palette fixture.")
  (entmod (ast:cad-put 10 '(9.0 4.0 0.0) (ast:cad-put 41 0.5
    (ast:cad-put 42 0.5 (entget output)))))
  (ast:ui-adopt (ast:cad-read second))
  (c:ASTUIGENERATE)
  (ast:cad-test-assert (and (ast:cad-placement-ok-p output)
    (equal first-data (entget first)) (equal second-data (entget second))
    (equal output (ast:cad-get 'output (ast:cad-read first)))
    (equal output (ast:cad-get 'output (ast:cad-read second)))
    (not (ast:cad-get 'stale (ast:cad-read first)))
    (not (ast:cad-get 'stale (ast:cad-read second))))
    "Generate from a connected member restores the shared output and preserves both guides")
  (setvar "INSUNITS" original-units) (setvar "TILEMODE" original-tile)
  (list (cons 'passed ast:*cad-test-passed*) (cons 'failed (length ast:*cad-test-failures*))
        (cons 'failures (reverse ast:*cad-test-failures*))))
(princ)
