;;; Pure network tests. Load geometry and network first; (ast:n-tests) touches no CAD.
(defun ast:n-test (condition label)
  (setq ast:n-test-count (1+ ast:n-test-count))
  (if (not condition) (setq ast:n-test-failures (cons label ast:n-test-failures))))
(defun ast:n-test-line (aa bb) (list '(kind . line) (cons 'a aa) (cons 'b bb)))
(defun ast:n-test-path (id primitives settings)
  (list (cons 'id id) (cons 'route (list (cons 'primitives primitives))) (cons 'settings settings) '(landmarks)))
(defun ast:n-test-connections (aa bb)
  (ast:g-get 'connections (ast:g-connect-candidates (ast:g-get 'route aa nil) (ast:g-get 'route bb nil)) nil))
(defun ast:n-test-rounds (result)
  (vl-remove-if-not '(lambda (opening) (= (ast:g-get 'type opening nil) 'round)) (ast:g-get 'openings result nil)))
(defun ast:n-test-same-cuts (aa bb)
  (and (ast:g-get 'ok aa nil) (ast:g-get 'ok bb nil)
    (= (length (ast:g-get 'openings aa nil)) (length (ast:g-get 'openings bb nil)))
    (vl-every '(lambda (opening) (vl-some '(lambda (other) (ast:g-same-opening opening other)) (ast:g-get 'openings bb nil))) (ast:g-get 'openings aa nil))))
(defun ast:n-test-shift-primitive (primitive delta)
  (if (= (ast:g-get 'kind primitive nil) 'line)
    (ast:n-put 'a (ast:g-add (ast:g-get 'a primitive nil) delta) (ast:n-put 'b (ast:g-add (ast:g-get 'b primitive nil) delta) primitive))
    (ast:n-put 'center (ast:g-add (ast:g-get 'center primitive nil) delta) primitive)))
(defun ast:n-test-shift-path (path delta / route primitives)
  (setq route (ast:g-get 'route path nil) primitives (mapcar '(lambda (primitive) (ast:n-test-shift-primitive primitive delta)) (ast:g-get 'primitives route nil)))
  (ast:n-put 'route (ast:n-put 'primitives primitives route) path))
(defun ast:n-test-remap (connections old-id new-id / node inc result incidences)
  (foreach node connections
    (setq incidences nil)
    (foreach inc (ast:g-get 'incidences node nil)
      (setq incidences (append incidences (list (if (= (ast:g-get 'path inc nil) old-id) (ast:n-put 'path new-id inc) inc)))))
    (setq result (append result (list (ast:n-put 'incidences incidences node))))) result)
(defun ast:n-tests (/ ast:n-test-count ast:n-test-failures settings horizontal vertical aa bb cc paths connections result reference circle arc closed shifted resolved selected modified openings opening rounds edge ordinary node hole near-count connection-a connection-b gap-result)
  (setq ast:n-test-count 0 ast:n-test-failures nil settings '((pitch . 3.0) (thickness . 0.2) (margin . 0.2)))
  (setq horizontal (ast:n-test-path 0 (list (ast:n-test-line '(-12.0 0.0) '(12.0 0.0))) settings)
        vertical (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) settings)
        connections (ast:n-test-connections horizontal vertical) paths (list horizontal vertical)
        result (ast:g-solve-set paths connections))
  (ast:n-test (and (= (length connections) 1) (= (length (ast:g-get 'incidences (car connections) nil)) 2)) "T finite intersection has two source incidences")
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) 13) (= (length (ast:n-test-rounds result)) 1)) "T emits one shared hole and twelve ordinary slits")
  (ast:n-test (not (ast:g-get 'ok (ast:g-solve-set paths nil) nil)) "undeclared crossing requires Connect")
  (setq vertical (ast:n-test-path 1 (list (ast:n-test-line '(0.0 -12.0) '(0.0 12.0))) settings)
        connections (ast:n-test-connections horizontal vertical) result (ast:g-solve-set (list horizontal vertical) connections))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) 17) (= (length (ast:n-test-rounds result)) 1)) "X emits one shared hole and sixteen ordinary slits")
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-30.0 0.0) '(0.0 0.0))) settings)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 -30.0))) settings)
        connections (ast:n-test-connections aa bb) result (ast:g-solve-set (list aa bb) connections)
        reference (ast:g-solve (list (cons 'primitives (append (ast:g-get 'primitives (ast:g-get 'route aa nil) nil) (ast:g-get 'primitives (ast:g-get 'route bb nil) nil)))) settings nil))
  (ast:n-test (ast:n-test-same-cuts result reference) "separate endpoint LINEs equal ordered polyline corner")
  (setq bb (ast:n-put 'settings (ast:n-put 'pitch 4.0 settings) bb)
        result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 1)) "two-arm corner respects separate incoming and outgoing pitch")
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(0.0 0.0) '(11.0 0.0))) settings)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(11.0 0.0) '(30.0 0.0))) settings)
        result (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb))
        reference (ast:g-solve (list (cons 'primitives (list (ast:n-test-line '(0.0 0.0) '(30.0 0.0))))) settings nil))
  (ast:n-test (ast:n-test-same-cuts result reference) "independent collinear subdivisions do not impose false phase")
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(0.0 0.0) '(30.0 0.0))) settings)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(10.0 0.0) '(40.0 0.0))) settings))
  (ast:n-test (not (ast:g-get 'ok (ast:g-connect-candidates (ast:g-get 'route aa nil) (ast:g-get 'route bb nil)) nil)) "positive-length overlap is rejected")
  (setq aa horizontal bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) (ast:n-put 'pitch 4.0 settings))
        result (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) 12)) "branch arms may retain different nominal pitches")
  (setq bb (ast:n-put 'settings (ast:n-put 'diameter 0.7 settings) bb))
  (ast:n-test (not (ast:g-get 'ok (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)) nil)) "incompatible physical hole profiles reject")
  (setq aa horizontal bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) settings)
        aa (ast:n-put 'landmarks '(((primitive . 0) (station . 12.0))) aa))
  (ast:n-test (not (ast:g-get 'ok (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)) nil)) "shared-hole versus centred-gap conflict rejects")
  (setq aa (ast:n-put 'settings (ast:n-put 'start 13.0 settings) horizontal))
  (ast:n-test (not (ast:g-get 'ok (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)) nil)) "range cannot silently discard connected intersection")
  (setq aa (ast:n-put 'settings (ast:n-put 'reverse T settings) horizontal)
        result (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:g-get 'openings result nil)) 13)) "reverse range retains source intersection attachment")
  ;; Two branch nodes on one path: nominal direct gap and shared midpoint slit.
  (foreach edge '(3.0 6.0 7.0)
    (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-12.0 0.0) (list (+ edge 12.0) 0.0))) settings)
          bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) settings)
          cc (ast:n-test-path 2 (list (ast:n-test-line (list edge 0.0) (list edge -12.0))) settings)
          connection-a (ast:n-test-connections aa bb)
          connection-b (ast:n-test-remap (ast:n-test-connections aa cc) 1 2)
          result (ast:g-solve-set (list aa bb cc) (append connection-a connection-b)))
    (ast:n-test (if (= edge 7.0) (not (ast:g-get 'ok result nil))
      (and (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 2) (= (length (ast:g-get 'openings result nil)) (if (= edge 3.0) 18 19))))
      (strcat "two branch nodes with " (rtos edge 2 0) " mm edge")))
  ;; A connected circle derives phase from its physical nodes, not its CAD seam.
  (setq circle (list '(kind . arc) '(center 0.0 0.0) '(radius . 10.0) '(start-angle . 0.0) (cons 'sweep (* 2.0 pi)))
        aa (ast:n-test-path 0 (list circle) settings)
        aa (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route aa nil)) aa)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 10.0) '(0.0 22.0))) settings)
        connections (ast:n-test-connections aa bb) result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 1)) "circle endpoint-line T supports curved arms")
  (setq reference result aa (ast:n-put 'settings (ast:n-put 'phase 7.0 settings) aa)
        result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (ast:n-test-same-cuts result reference) "circle phase does not introduce a second physical anchor")
  (setq hole '(0.0 10.0) near-count 0)
  (foreach opening (ast:g-get 'openings result nil)
    (if (and (= (ast:g-get 'type opening nil) 'slit) (ast:g-near (ast:g-dist hole (ast:g-get 'center opening nil)) 3.0)) (setq near-count (1+ near-count))))
  (ast:n-test (= near-count 3) "curved branch first gaps are exact three-millimetre chords")
  ;; Two finite roots require explicit selection and preserve their branch on edits.
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-16.0 0.0) '(16.0 0.0))) settings)
        bb (ast:n-test-path 1 (list circle) settings)
        bb (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route bb nil)) bb)
        connections (ast:n-test-connections aa bb))
  (ast:n-test (= (length connections) 2) "line circle enumerates both finite intersections")
  (setq selected (list (car connections)) shifted (list (ast:n-test-shift-path aa '(100.0 70.0)) (ast:n-test-shift-path bb '(100.0 70.0)))
        resolved (ast:g-resolve-connections shifted selected))
  (ast:n-test (and (ast:g-get 'ok resolved nil) (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
    (ast:g-add (ast:g-get 'point (car selected) nil) '(100.0 70.0))) 1e-8)) "saved intersection follows provable common move")
  (setq modified (ast:n-put 'route (list (cons 'primitives (list (ast:n-put 'radius 11.0 circle))) '(closed . T)) bb)
        resolved (ast:g-resolve-connections (list aa modified) selected))
  (ast:n-test (and (ast:g-get 'ok resolved nil) (= (ast:g-sign (car (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)))
    (ast:g-sign (car (ast:g-get 'point (car selected) nil))))) "radius edit retains selected analytic root side")
  (ast:n-test (not (ast:g-get 'ok (ast:g-solve-set (list aa bb) selected) nil)) "second undeclared circle crossing is not silently coordinated")
  (setq result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (and (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 2)) "two declared circle intersections share two holes")
  ;; Changed topology must not attach the saved primitive index to a different segment.
  (setq modified (ast:n-put 'route (list (cons 'primitives (list (ast:n-test-line '(-16.0 0.0) '(0.0 0.0)) (ast:n-test-line '(0.0 0.0) '(16.0 0.0))))) aa))
  (ast:n-test (not (ast:g-get 'ok (ast:g-resolve-connections (list modified bb) selected) nil)) "topology changes request an explicit repick")
  (setq modified (ast:n-put 'route (list (cons 'primitives (list (ast:g-reverse-primitive (car (ast:g-get 'primitives (ast:g-get 'route aa nil) nil)))))) aa)
        resolved (ast:g-resolve-connections (list modified bb) selected))
  (ast:n-test (and (ast:g-get 'ok resolved nil) (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
    (ast:g-get 'point (car selected) nil)) 1e-8)) "native line reversal retains same physical chosen root")
  ;; A common move can put the unselected root at the former selected point.
  (setq shifted (list (ast:n-test-shift-path aa '(20.0 0.0)) (ast:n-test-shift-path bb '(20.0 0.0)))
        resolved (ast:g-resolve-connections shifted connections))
  (ast:n-test (and (ast:g-get 'ok resolved nil) (= (length (ast:g-get 'connections resolved nil)) 2)
    (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
      (ast:g-add (ast:g-get 'point (car connections) nil) '(20.0 0.0))) 1e-8)) "common motion wins over an old-world-point coincidence")
  ;; Several declarations at one physical point form one opening, transitively.
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-12.0 0.0) '(0.0 0.0))) settings)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) settings)
        cc (ast:n-test-path 2 (list (ast:n-test-line '(0.0 0.0) '(12.0 0.0))) settings)
        connections (append (ast:n-test-connections aa bb) (ast:n-test-remap (ast:n-test-connections aa cc) 1 2))
        reference (ast:g-solve-set (list aa bb cc) connections)
        result (ast:g-solve-set (list cc bb aa) connections))
  (ast:n-test (and (ast:g-get 'ok reference nil) (= (length (ast:g-get 'openings reference nil)) 13) (= (length (ast:n-test-rounds reference)) 1)) "three co-located declarations reuse one physical hole")
  (ast:n-test (ast:n-test-same-cuts result reference) "member enumeration order does not change T geometry")
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-12.0 0.0) '(0.0 0.0)) (ast:n-test-line '(0.0 0.0) '(0.0 12.0))) settings)
        bb (ast:n-test-path 1 (list (ast:n-test-line '(0.0 0.0) '(12.0 0.0))) settings)
        result (ast:g-solve-set (list aa bb) (ast:n-test-connections aa bb)))
  (ast:n-test (ast:n-test-same-cuts result reference) "polyline corner plus third branch equals three separate arms")
  ;; Curved branch cases exercise all-arc finite intersections and tangent-aligned cuts.
  (setq aa (ast:n-test-path 0 (list circle) settings)
        aa (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route aa nil)) aa)
        arc (list '(kind . arc) '(center 10.0 10.0) '(radius . 10.0) (cons 'start-angle (- (/ pi 2.0))) (cons 'sweep (* 8.0 (ast:g-asin 0.15))))
        bb (ast:n-test-path 1 (list arc) settings)
        connections (ast:n-test-connections aa bb) result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (and (= (length connections) 1) (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 1)) "arc endpoint to circle interior T")
  (setq aa (ast:n-test-path 0 (list (ast:n-put 'center '(-5.0 0.0) circle)) settings)
        aa (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route aa nil)) aa)
        bb (ast:n-test-path 1 (list (ast:n-put 'center '(5.0 0.0) circle)) settings)
        bb (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route bb nil)) bb)
        connections (ast:n-test-connections aa bb) result (ast:g-solve-set (list aa bb) connections))
  (ast:n-test (and (= (length connections) 2) (ast:g-get 'ok result nil) (= (length (ast:n-test-rounds result)) 2)) "two circle-circle X nodes")
  (setq selected (list (car connections))
        modified (ast:n-put 'route (list (cons 'primitives (mapcar 'ast:g-reverse-primitive (ast:g-get 'primitives (ast:g-get 'route aa nil) nil))) '(closed . T)) aa)
        resolved (ast:g-resolve-connections (list modified bb) selected))
  (ast:n-test (and (ast:g-get 'ok resolved nil) (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
    (ast:g-get 'point (car selected) nil)) 1e-8)) "one full-circle traversal reversal preserves physical root")
  (setq shifted (ast:n-put 'route (list (cons 'primitives (mapcar 'ast:g-reverse-primitive (ast:g-get 'primitives (ast:g-get 'route bb nil) nil))) '(closed . T)) bb)
        resolved (ast:g-resolve-connections (list modified shifted) selected))
  (ast:n-test (and (not (ast:g-get 'ok resolved nil)) (= (type (ast:g-get 'error resolved nil)) 'STR)
    (wcmatch (ast:g-get 'error resolved "") "*ambiguous*")) "symmetric circle reversal cannot silently become a reflected root")
  (setq resolved (ast:g-resolve-connections (list (ast:n-test-shift-path modified '(20.0 30.0)) (ast:n-test-shift-path shifted '(20.0 30.0))) selected))
  (ast:n-test (not (ast:g-get 'ok resolved nil)) "translated symmetric reversal still requires explicit attachment repair")
  ;; A source direction edit must not invert root identity during another edit.
  (setq aa (ast:n-test-path 0 (list (ast:n-test-line '(-16.0 0.0) '(16.0 0.0))) settings)
        bb (ast:n-test-path 1 (list circle) settings)
        bb (ast:n-put 'route (ast:n-put 'closed T (ast:g-get 'route bb nil)) bb)
        connections (ast:n-test-connections aa bb)
        modified (ast:n-put 'route (list (cons 'primitives (list (ast:n-test-line '(16.0 0.0) '(-16.0 0.0))))) aa)
        shifted (ast:n-put 'route (list (cons 'primitives (list (ast:n-put 'radius 11.0 circle))) '(closed . T)) bb))
  (foreach node connections
    (setq resolved (ast:g-resolve-connections (list modified shifted) (list node)))
    (ast:n-test (and (ast:g-get 'ok resolved nil)
      (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
        (list (* 11.0 (ast:g-sign (car (ast:g-get 'point node nil)))) 0.0)) 1e-8))
      "line reversal plus radius edit preserves selected positive or negative root"))
  ;; AutoLISP OR returns a boolean, so error messages must be propagated explicitly.
  (setq result (ast:g-connect-candidates nil (ast:g-get 'route aa nil)))
  (ast:n-test (and (not (ast:g-get 'ok result nil)) (= (type (ast:g-get 'error result nil)) 'STR)
    (= (ast:g-get 'error result nil) "No guide primitives.")) "first invalid candidate route preserves diagnostic string")
  (setq result (ast:g-connect-candidates (ast:g-get 'route aa nil) nil))
  (ast:n-test (and (not (ast:g-get 'ok result nil)) (= (type (ast:g-get 'error result nil)) 'STR)) "second invalid candidate route preserves diagnostic string")
  (setq result (ast:n-prepare (ast:n-put 'settings '((pitch . -1.0)) aa)))
  (ast:n-test (and (not (ast:g-get 'ok result nil)) (= (type (ast:g-get 'error result nil)) 'STR)) "invalid physical profile preserves diagnostic string")
  (setq result (ast:n-prepare (ast:n-put 'route nil aa)))
  (ast:n-test (and (not (ast:g-get 'ok result nil)) (= (type (ast:g-get 'error result nil)) 'STR)) "invalid prepared route preserves diagnostic string")
  ;; Swapping circle/line incidence order must not change the selected-root rule.
  (setq reference aa aa (ast:n-put 'id 0 bb) bb (ast:n-put 'id 1 reference)
        connections (ast:n-test-connections aa bb)
        modified (ast:n-put 'route (list (cons 'primitives (list (ast:n-put 'radius 11.0 circle))) '(closed . T)) aa)
        shifted (ast:n-put 'route (list (cons 'primitives (list (ast:n-test-line '(16.0 0.0) '(-16.0 0.0))))) bb))
  (foreach node connections
    (setq resolved (ast:g-resolve-connections (list modified shifted) (list node)))
    (ast:n-test (and (ast:g-get 'ok resolved nil)
      (< (ast:g-dist (ast:g-get 'point (car (ast:g-get 'connections resolved nil)) nil)
        (list (* 11.0 (ast:g-sign (car (ast:g-get 'point node nil)))) 0.0)) 1e-8))
      "circle-first incidence order preserves reversed-line edited-radius root"))
  (list (cons 'ok (null ast:n-test-failures)) (cons 'count ast:n-test-count) (cons 'failures (reverse ast:n-test-failures))))
(princ)
