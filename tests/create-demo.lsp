;;; Load AUTOSTITCH.lsp first; run (ast:create-demo) in an empty disposable drawing.
(defun ast:demo-fail (message)
  (setq ast:*cad-error* message)
  (princ (strcat "\nAutostitch demo: " message))
  (exit))
(defun ast:demo-label (point caption)
  (entmakex (list '(0 . "TEXT") '(8 . "DEMO-NOTES") (cons 10 point)
    '(40 . 1.8) (cons 1 caption))))
(defun ast:demo-generate (guide gaps / result)
  (setq result (ast:cad-generate guide (ast:cad-default-settings) gaps))
  (if (not (ast:cad-get 'ok result))
    (ast:demo-fail (strcat "Generation failed: " (ast:cad-get 'error result))))
  (setq ast:demo:*guides* (append ast:demo:*guides* (list guide)))
  result)
(defun ast:demo-connect (first second caption / result)
  (setq result (ast:cad-connect first second nil (ast:cad-default-settings) nil))
  (if (not (ast:cad-get 'ok result))
    (ast:demo-fail (strcat caption " could not connect: " (ast:cad-get 'error result))))
  (setq ast:demo:*guides* (append ast:demo:*guides* (list first second)))
  result)
(defun ast:create-demo (/ document guide first second layer data)
  (ast:load-components)
  (setq document (vla-get-ActiveDocument (vlax-get-acad-object)))
  (if (> (vla-get-Count (vla-get-ModelSpace document)) 0)
    (ast:demo-fail "Create the demo in an empty drawing."))
  (setvar "INSUNITS" 4) (setvar "TILEMODE" 1)
  (foreach layer '(("DEMO-GUIDES" . 8) ("DEMO-NOTES" . 8) ("AUTOSTITCH" . 7) ("AUTOSTITCH_UI" . 7))
    (if (not (tblsearch "LAYER" (car layer)))
      (if (not (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
        '(100 . "AcDbLayerTableRecord") (cons 2 (car layer)) '(70 . 0)
        (cons 62 (cdr layer)) '(6 . "Continuous"))))
        (ast:demo-fail (strcat "Could not create layer " (car layer)))))
    (setq data (ast:cad-put 62 (cdr layer) (entget (tblobjname "LAYER" (car layer)))))
    (if (= (car layer) "AUTOSTITCH_UI") (setq data (ast:cad-put 290 0 data)))
    (if (not (entmod data)) (ast:demo-fail (strcat "Could not set up layer " (car layer)))))
  (setq ast:demo:*guides* nil)
  (ast:demo-label '(0.0 90.0 0.0) "AUTOSTITCH  |  Select stitch line, change pitch, Generate stitches")
  (ast:demo-label '(0.0 84.0 0.0) "Connect stitch lines where they meet or cross. Edit a source, then Generate stitches.")
  (ast:demo-label '(0.0 78.0 0.0) "White: slit holes. Amber: adjusted spacing / AWL. Show stitches adds a thread preview.")
  (ast:demo-label '(0.0 68.0 0.0) "Straight line / pattern landmark at 31.5 mm")
  (setq guide (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 0.0 63.0 0.0) (11 70.5 63.0 0.0))))
  (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 31.5 55.0 0.0) (11 31.5 66.0 0.0)))
  (ast:demo-generate guide '(((primitive . 0) (station . 31.5))))
  (ast:demo-label '(0.0 40.0 0.0) "Closed line / four corners")
  (setq guide (entmakex '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (8 . "DEMO-GUIDES")
    (100 . "AcDbPolyline") (90 . 4) (70 . 1) (10 0.0 0.0) (10 60.0 0.0) (10 60.0 30.0) (10 0.0 30.0))))
  (ast:demo-generate guide nil)
  (ast:demo-label '(0.0 -12.0 0.0) "Line / tangent arc / line")
  (setq guide (entmakex '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (8 . "DEMO-GUIDES")
    (100 . "AcDbPolyline") (90 . 4) (70 . 0) (10 0.0 -45.0) (42 . 0.0)
    (10 30.0 -45.0) (42 . 0.4142135623730950) (10 45.0 -30.0) (42 . 0.0) (10 45.0 -18.0) (42 . 0.0))))
  (ast:demo-generate guide nil)
  (ast:demo-label '(84.0 40.0 0.0) "Closed circle")
  (setq guide (entmakex '((0 . "CIRCLE") (8 . "DEMO-GUIDES") (10 105.0 15.0 0.0) (40 . 20.0))))
  (ast:demo-generate guide nil)
  (ast:demo-label '(160.0 68.0 0.0) "Connected T")
  (ast:demo-label '(160.0 63.0 0.0) "Two lines / one shared hole")
  (setq first (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 164.0 45.0 0.0) (11 188.0 45.0 0.0)))
        second (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 176.0 45.0 0.0) (11 176.0 57.0 0.0))))
  (ast:demo-connect first second "Connected T")
  (ast:demo-label '(225.0 68.0 0.0) "Connected X")
  (ast:demo-label '(225.0 63.0 0.0) "Two lines / one shared hole")
  (setq first (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 230.0 45.0 0.0) (11 254.0 45.0 0.0)))
        second (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 242.0 33.0 0.0) (11 242.0 57.0 0.0))))
  (ast:demo-connect first second "Connected X")
  (ast:demo-label '(160.0 25.0 0.0) "90-degree corner")
  (ast:demo-label '(160.0 20.0 0.0) "Two separate lines / no Join")
  (setq first (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 160.0 0.0 0.0) (11 190.0 0.0 0.0)))
        second (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 190.0 0.0 0.0) (11 190.0 -30.0 0.0))))
  (ast:demo-connect first second "Separate-line corner")
  (ast:demo-label '(220.0 25.0 0.0) "Circle + line / two crossings")
  (ast:demo-label '(220.0 20.0 0.0) "ConnectAll / two shared holes")
  (setq first (entmakex '((0 . "LINE") (8 . "DEMO-GUIDES") (10 226.0 -8.0 0.0) (11 258.0 -8.0 0.0)))
        second (entmakex '((0 . "CIRCLE") (8 . "DEMO-GUIDES") (10 242.0 -8.0 0.0) (40 . 10.0))))
  (ast:demo-connect first second "Circle and line")
  (ast:demo-label '(0.0 -58.0 0.0) "3 mm pitch. Physical tool width and margin still need calibration.")
  (vla-ZoomExtents (vlax-get-acad-object))
  (c:AUTOSTITCH)
  (ast:ui-adopt (ast:cad-read (car ast:demo:*guides*)))
  (ast:ui-status "Eight examples ready. Select a stitch line, edit it, then Generate stitches.")
  (vla-Save document)
  (princ))
(princ)
